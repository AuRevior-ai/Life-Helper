page {
  background: #f6f8f5;
  color: #1f2d2a;
  font-size: 28rpx;
}

.page-shell {
  min-height: 100vh;
  padding: 36rpx 28rpx;
  box-sizing: border-box;
}

.page-header {
  margin-bottom: 28rpx;
}

.page-title {
  color: #183832;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.25;
}

.page-subtitle {
  margin-top: 10rpx;
  color: #64716d;
  font-size: 26rpx;
  line-height: 1.5;
}

.panel {
  padding: 28rpx;
  border: 1rpx solid #dfe8e3;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(31, 77, 69, 0.06);
}

.muted-text {
  color: #72807b;
}

.primary-button,
.ghost-button {
  height: 88rpx;
  margin: 28rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.primary-button {
  background: #1f7a68;
  color: #ffffff;
}

.ghost-button {
  border: 1rpx solid #bfd8d0;
  background: #ffffff;
  color: #1f7a68;
}

.text-button {
  display: inline-flex;
  width: auto;
  min-width: 0;
  height: 56rpx;
  margin: 0;
  padding: 0 18rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #dfe8e3;
  border-radius: 8rpx;
  background: #ffffff;
  color: #1f7a68;
  font-size: 24rpx;
  line-height: 54rpx;
}

.text-button::after {
  border: 0;
}

.danger {
  color: #b65230;
}

.default-tag {
  display: inline-flex;
  height: 42rpx;
  padding: 0 14rpx;
  align-items: center;
  border-radius: 8rpx;
  background: #e8f2ee;
  color: #1f7a68;
  font-size: 22rpx;
  font-weight: 700;
}

.form-panel {
  margin-top: 22rpx;
}

.form-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf2ef;
}

.form-item:first-child {
  padding-top: 0;
}

.form-item:last-child {
  border-bottom: 0;
}

.form-label {
  display: block;
  margin-bottom: 14rpx;
  color: #33433f;
  font-size: 26rpx;
  font-weight: 700;
}

.form-input,
.form-textarea {
  width: 100%;
  box-sizing: border-box;
  border-radius: 10rpx;
  background: #f6f8f5;
  color: #1f2d2a;
  font-size: 28rpx;
}

.form-input {
  height: 76rpx;
  padding: 0 20rpx;
}

.form-textarea {
  min-height: 150rpx;
  padding: 18rpx 20rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 34rpx 0 18rpx;
  color: #1f2d2a;
  font-size: 32rpx;
  font-weight: 800;
}
