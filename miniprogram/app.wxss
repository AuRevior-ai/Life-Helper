page {
  background: #f6f8f5;
  color: #1f2d2a;
  font-size: 28rpx;
}

.page-shell {
  min-height: 100vh;
  padding: 36rpx 28rpx;
  box-sizing: border-box;
}

.page-header {
  margin-bottom: 28rpx;
}

.page-title {
  color: #183832;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.25;
}

.page-subtitle {
  margin-top: 10rpx;
  color: #64716d;
  font-size: 26rpx;
  line-height: 1.5;
}

.panel {
  padding: 28rpx;
  border: 1rpx solid #dfe8e3;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(31, 77, 69, 0.06);
}

.muted-text {
  color: #72807b;
}
