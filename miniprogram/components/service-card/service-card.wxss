.service-card {
  display: flex;
  gap: 22rpx;
  padding: 24rpx;
  border: 0;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(31, 41, 55, 0.06);
  box-sizing: border-box;
}

.service-card__cover {
  width: 152rpx;
  height: 132rpx;
  flex: 0 0 152rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #eef2f3 0%, #dfe8e3 100%);
}

.service-card__body {
  min-width: 0;
  flex: 1;
}

.service-card__name {
  overflow: hidden;
  color: #111827;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 38rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-card__desc {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 25rpx;
  line-height: 1.4;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.service-card__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  color: #9ca3af;
  font-size: 24rpx;
}

.service-card__price {
  color: #ff6a00;
  font-size: 30rpx;
  font-weight: 900;
}
