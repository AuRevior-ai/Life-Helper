.worker-tabbar {
  position: fixed;
  z-index: 90;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  min-height: calc(126rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  align-items: center;
  padding: 10rpx 0 env(safe-area-inset-bottom);
  border-top: 1rpx solid #edf0f2;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -8rpx 28rpx rgba(31, 41, 55, 0.07);
}

.worker-tabbar__item {
  display: flex;
  width: 33.333%;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #6b7280;
  font-size: 22rpx;
  line-height: 28rpx;
}

.worker-tabbar__item--active {
  color: #16a34a;
}

.worker-tabbar__icon {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  box-sizing: border-box;
  color: inherit;
}

.worker-tabbar__icon--briefcase {
  top: 4rpx;
  border: 5rpx solid currentColor;
  border-radius: 10rpx;
}

.worker-tabbar__icon--briefcase::before {
  position: absolute;
  top: -15rpx;
  left: 12rpx;
  width: 18rpx;
  height: 12rpx;
  box-sizing: border-box;
  border: 5rpx solid currentColor;
  border-bottom: 0;
  border-radius: 10rpx 10rpx 0 0;
  content: "";
}

.worker-tabbar__icon--briefcase::after {
  position: absolute;
  top: 16rpx;
  left: 13rpx;
  width: 12rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: currentColor;
  content: "";
}

.worker-tabbar__icon--orders {
  border: 5rpx solid currentColor;
  border-radius: 9rpx;
}

.worker-tabbar__icon--orders::before {
  position: absolute;
  top: -11rpx;
  left: 12rpx;
  width: 18rpx;
  height: 13rpx;
  box-sizing: border-box;
  border: 5rpx solid currentColor;
  border-radius: 10rpx;
  background: #ffffff;
  content: "";
}

.worker-tabbar__icon--orders::after {
  position: absolute;
  top: 15rpx;
  left: 10rpx;
  width: 22rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: currentColor;
  box-shadow: 0 13rpx 0 currentColor;
  content: "";
}

.worker-tabbar__icon--profile::before {
  position: absolute;
  top: 3rpx;
  left: 15rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: currentColor;
  content: "";
}

.worker-tabbar__icon--profile::after {
  position: absolute;
  bottom: 2rpx;
  left: 7rpx;
  width: 34rpx;
  height: 24rpx;
  border-radius: 24rpx 24rpx 8rpx 8rpx;
  background: currentColor;
  content: "";
}

.worker-tabbar__text {
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
