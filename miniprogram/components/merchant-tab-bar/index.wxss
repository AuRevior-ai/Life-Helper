.merchant-tabbar {
  position: fixed;
  z-index: 90;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  min-height: calc(132rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  align-items: center;
  padding: 12rpx 0 env(safe-area-inset-bottom);
  border-radius: 36rpx 36rpx 0 0;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -14rpx 42rpx rgba(24, 44, 39, 0.1);
}

.merchant-tabbar__item {
  display: flex;
  width: 20%;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #75827d;
  font-size: 23rpx;
  line-height: 30rpx;
}

.merchant-tabbar__item--active {
  color: #1f7a68;
}

.merchant-tabbar__icon {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  box-sizing: border-box;
  color: inherit;
}

.merchant-tabbar__icon--profile::before {
  position: absolute;
  top: 3rpx;
  left: 15rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: currentColor;
  content: "";
}

.merchant-tabbar__icon--profile::after {
  position: absolute;
  bottom: 2rpx;
  left: 7rpx;
  width: 34rpx;
  height: 24rpx;
  border-radius: 24rpx 24rpx 8rpx 8rpx;
  background: currentColor;
  content: "";
}

.merchant-tabbar__icon--order,
.merchant-tabbar__icon--service,
.merchant-tabbar__icon--status {
  border: 5rpx solid currentColor;
  border-radius: 10rpx;
}

.merchant-tabbar__icon--order::before {
  position: absolute;
  top: -11rpx;
  left: 12rpx;
  width: 18rpx;
  height: 13rpx;
  box-sizing: border-box;
  border: 5rpx solid currentColor;
  border-radius: 10rpx;
  background: #ffffff;
  content: "";
}

.merchant-tabbar__icon--order::after,
.merchant-tabbar__icon--service::after {
  position: absolute;
  top: 15rpx;
  left: 10rpx;
  width: 22rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: currentColor;
  box-shadow: 0 13rpx 0 currentColor;
  content: "";
}

.merchant-tabbar__icon--service::before {
  position: absolute;
  top: -5rpx;
  right: -5rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: currentColor;
  content: "";
}

.merchant-tabbar__icon--income {
  border-bottom: 5rpx solid currentColor;
}

.merchant-tabbar__icon--income::before {
  position: absolute;
  right: 6rpx;
  bottom: 0;
  left: 6rpx;
  height: 34rpx;
  border: 5rpx solid currentColor;
  border-bottom: 0;
  border-radius: 999rpx 999rpx 0 0;
  content: "";
}

.merchant-tabbar__icon--status::before {
  position: absolute;
  top: 11rpx;
  left: 12rpx;
  width: 20rpx;
  height: 12rpx;
  border-bottom: 5rpx solid currentColor;
  border-left: 5rpx solid currentColor;
  content: "";
  transform: rotate(-45deg);
}

.merchant-tabbar__text {
  max-width: 112rpx;
  overflow: hidden;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}
