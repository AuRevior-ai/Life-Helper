<view
  wx:if="{{ variant === 'center' }}"
  class="order-card order-card--center"
  bindtap="onTap"
>
  <view class="order-card__media">
    <image
      wx:if="{{ order.image || order.cover_image || order.service_image }}"
      class="order-card__image"
      src="{{ order.image || order.cover_image || order.service_image }}"
      mode="aspectFill"
    ></image>
    <view wx:else class="order-card__image-placeholder"></view>
  </view>

  <view class="order-card__main">
    <view class="order-card__name"
      >{{ order.service_name || order.serviceName || '服务订单' }}</view
    >
    <view class="order-card__meta">
      <view class="order-card__meta-icon order-card__meta-icon--time"></view>
      <text
        >预约时间：{{ order.appointment_time || order.appointmentTime ||
        '时间待确认' }}</text
      >
    </view>
    <view class="order-card__meta">
      <view
        class="order-card__meta-icon order-card__meta-icon--location"
      ></view>
      <text>服务地址：{{ displayAddress }}</text>
    </view>
  </view>

  <view class="order-card__aside">
    <status-tag text="{{ statusText }}" tone="{{ statusTone }}"></status-tag>
    <view class="order-card__price">{{ displayPriceText }}</view>
  </view>

  <view wx:if="{{ actionButtons.length }}" class="order-card__actions">
    <button
      wx:for="{{ actionButtons }}"
      wx:key="type"
      class="order-card__action order-card__action--{{ item.style }}"
      data-action="{{ item.type }}"
      catchtap="onActionTap"
    >
      {{ item.label }}
    </button>
  </view>
</view>

<view wx:else class="order-card" bindtap="onTap">
  <view class="order-card__top">
    <text class="order-card__name">{{ order.service_name }}</text>
    <text class="order-card__status">{{ statusText }}</text>
  </view>
  <view class="order-card__line">{{ order.appointment_time }}</view>
  <view class="order-card__bottom">
    <text>{{ order.community }}</text>
    <text class="order-card__price">{{ priceText }}</text>
  </view>
</view>
