.order-card {
  padding: 24rpx;
  border: 1rpx solid #dfe8e3;
  border-radius: 12rpx;
  background: #ffffff;
}

.order-card__top,
.order-card__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.order-card__name {
  color: #1f2d2a;
  font-size: 30rpx;
  font-weight: 700;
}

.order-card__status {
  color: #1f7a68;
  font-size: 24rpx;
  font-weight: 600;
}

.order-card__line {
  margin: 16rpx 0;
  color: #64716d;
  font-size: 25rpx;
}

.order-card__bottom {
  color: #72807b;
  font-size: 24rpx;
}

.order-card__price {
  color: #c66b2d;
  font-weight: 700;
}
