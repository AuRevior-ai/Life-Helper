<view class="admin-tabbar">
  <view
    wx:for="{{ tabs }}"
    wx:key="key"
    class="admin-tabbar__item {{ active === item.key ? 'admin-tabbar__item--active' : '' }}"
    data-key="{{ item.key }}"
    bindtap="onTabTap"
  >
    <view class="admin-tabbar__icon admin-tabbar__icon--{{ item.icon }}"></view>
    <text class="admin-tabbar__text">{{ item.text }}</text>
  </view>
</view>
