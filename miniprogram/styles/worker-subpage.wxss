/*
 * Worker secondary page shell.
 * Keep these styles visual-only: no business state or data assumptions here.
 */

.worker-subpage,
.worker-subpage view,
.worker-subpage text,
.worker-subpage image,
.worker-subpage button,
.worker-subpage input,
.worker-subpage textarea,
.worker-subpage picker,
.worker-subpage scroll-view {
  box-sizing: border-box;
}

.worker-subpage {
  min-height: 100vh;
  overflow-x: hidden;
  padding: calc(116rpx + env(safe-area-inset-top)) 36rpx
    calc(172rpx + env(safe-area-inset-bottom));
  background: #f7f9f7;
  color: #101828;
  font-family:
    -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial,
    sans-serif;
}

.worker-subpage-header {
  margin-bottom: 30rpx;
}

.worker-subpage-title {
  color: #05070a;
  font-size: 44rpx;
  font-weight: 900;
  letter-spacing: 0;
  line-height: 58rpx;
}

.worker-subpage-subtitle {
  margin-top: 14rpx;
  color: #64748b;
  font-size: 25rpx;
  line-height: 38rpx;
}

.worker-section-card {
  overflow: hidden;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 34rpx rgba(15, 23, 42, 0.07);
}

.worker-section-title {
  color: #101828;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.worker-section-kicker {
  color: #16a34a;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 32rpx;
}

.worker-muted {
  color: #64748b;
}

.worker-info-row {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
}

.worker-info-main {
  min-width: 0;
  flex: 1;
}

.worker-text-ellipsis {
  overflow: hidden;
  min-width: 0;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.worker-primary-button,
.worker-secondary-button,
.worker-danger-button {
  display: flex;
  height: 76rpx;
  min-width: 0;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 76rpx;
  white-space: nowrap;
}

.worker-primary-button {
  border: 0;
  background: #16a34a;
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(22, 163, 74, 0.18);
}

.worker-secondary-button {
  border: 1rpx solid #16a34a;
  background: #ffffff;
  color: #16a34a;
}

.worker-danger-button {
  border: 1rpx solid #f97316;
  background: #fff7ed;
  color: #f97316;
}

.worker-primary-button::after,
.worker-secondary-button::after,
.worker-danger-button::after {
  border: 0;
}

.worker-pill {
  display: inline-flex;
  min-height: 42rpx;
  align-items: center;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 42rpx;
  white-space: nowrap;
}

.worker-pill--green {
  background: #eaf8e8;
  color: #16a34a;
}

.worker-pill--orange {
  background: #fff3e8;
  color: #f97316;
}

.worker-pill--blue {
  background: #eaf2ff;
  color: #2475e8;
}

.worker-bottom-action-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  gap: 20rpx;
  padding: 22rpx 36rpx calc(22rpx + env(safe-area-inset-bottom));
  border-radius: 34rpx 34rpx 0 0;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -10rpx 34rpx rgba(15, 23, 42, 0.08);
}
