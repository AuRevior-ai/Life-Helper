/*
 * Stage 22C-0 user UI kit.
 * Import this file explicitly in future user-facing page WXSS files.
 * Do not import globally until the remaining pages have been migrated.
 */

.ui-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 96rpx 40rpx 170rpx;
  background: #f7f8fa;
  color: #111827;
  font-family:
    -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial,
    sans-serif;
}

.ui-page--dense {
  padding-right: 32rpx;
  padding-left: 32rpx;
}

.ui-safe-tabbar {
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
}

.ui-header {
  margin-bottom: 28rpx;
}

.ui-title {
  color: #111827;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.25;
}

.ui-subtitle {
  margin-top: 18rpx;
  color: #6b7280;
  font-size: 26rpx;
  line-height: 38rpx;
}

.ui-card {
  box-sizing: border-box;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(31, 41, 55, 0.06);
}

.ui-card--compact {
  padding: 24rpx;
  border-radius: 24rpx;
}

.ui-card--bordered {
  border: 1rpx solid #eef0f2;
  box-shadow: none;
}

.ui-feature-card {
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #eefbea 0%, #e4f8e4 55%, #ddf4dd 100%);
  box-shadow: 0 12rpx 32rpx rgba(25, 166, 74, 0.08);
}

.ui-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ui-section-title {
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.3;
}

.ui-section-more {
  color: #8a8f98;
  font-size: 26rpx;
  line-height: 1.3;
}

.ui-row {
  display: flex;
  min-width: 0;
  align-items: center;
}

.ui-text-ellipsis {
  overflow: hidden;
  min-width: 0;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ui-muted {
  color: #6b7280;
}

.ui-weak {
  color: #9ca3af;
}

.ui-price {
  color: #ff6a00;
  font-weight: 900;
  white-space: nowrap;
}

.ui-primary-button,
.ui-secondary-button {
  display: flex;
  width: auto;
  min-width: 112rpx;
  height: 52rpx;
  margin: 0;
  padding: 0 24rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 52rpx;
  white-space: nowrap;
}

.ui-primary-button {
  border: 0;
  background: #16a34a;
  color: #ffffff;
}

.ui-secondary-button {
  border: 1rpx solid #d1d5db;
  background: #ffffff;
  color: #4b5563;
}

.ui-outline-button {
  border: 2rpx solid #19a64a;
  background: #ffffff;
  color: #19a64a;
}

.ui-primary-button::after,
.ui-secondary-button::after,
.ui-outline-button::after {
  border: 0;
}

.ui-pill {
  display: inline-flex;
  min-height: 40rpx;
  padding: 0 16rpx;
  align-items: center;
  border-radius: 999rpx;
  box-sizing: border-box;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 40rpx;
  white-space: nowrap;
}

.ui-pill--green {
  background: #eaf8e8;
  color: #16a34a;
}

.ui-pill--orange {
  background: #fff3e8;
  color: #ff6a00;
}

.ui-pill--gray {
  background: #f3f4f6;
  color: #6b7280;
}

.ui-media-placeholder {
  background: linear-gradient(135deg, #eef2f3 0%, #dfe8e3 100%);
}

.ui-avatar-placeholder {
  background: #f4fff2;
}

.ui-divider {
  height: 1rpx;
  background: #edf0f2;
}
