<view class="page-shell">
  <view class="page-header"><view class="page-title">{{ title }}</view></view>
  <view wx:if="{{ appeal }}" class="panel">
    <view class="info-row"><text>申诉理由</text><text>{{ appeal.reason }}</text></view>
    <view class="info-row"><text>状态</text><text>{{ appeal.status }}</text></view>
    <textarea class="form-textarea" placeholder="审核备注" bindinput="onRemarkInput"></textarea>
    <button class="primary-button" data-result="approved" bindtap="reviewAppeal" loading="{{ submitting }}" disabled="{{ submitting }}">通过申诉</button>
    <button class="ghost-button" data-result="rejected" bindtap="reviewAppeal" loading="{{ submitting }}" disabled="{{ submitting }}">拒绝申诉</button>
  </view>
</view>
