<view class="admin-page admin-secondary-page">
  <view class="admin-header">
    <view class="admin-title">{{ title }}</view>
    <view class="admin-subtitle">
      维护服务名称、分类、价格展示和上下架状态，保存动作仍通过 service 服务层完成。
    </view>
  </view>

  <view class="admin-status-card">
    <view class="admin-card-title">服务配置</view>
    <view class="admin-card-desc">
      价格输入以元展示，提交时继续按既有逻辑转换为分，不改变后端价格计算或订单快照。
    </view>
  </view>

  <view wx:if="{{ errorText }}" class="admin-error-card">{{ errorText }}</view>

  <view class="admin-loading-wrap" wx:if="{{ loading }}">
    <loading-view text="正在加载服务信息"></loading-view>
  </view>

  <block wx:else>
    <view class="admin-section-card">
      <view class="admin-section-title">基础信息</view>
      <view class="form-item">
        <text class="form-label">服务分类</text>
        <picker
          mode="selector"
          range="{{ categoryNames }}"
          value="{{ categoryIndex }}"
          bindchange="onCategoryChange"
        >
          <view class="picker-value">{{ selectedCategoryName }}</view>
        </picker>
      </view>
      <view class="form-item">
        <text class="form-label">服务名称</text>
        <input
          class="form-input"
          value="{{ name }}"
          data-field="name"
          placeholder="例如：日常保洁"
          bindinput="onInput"
        />
      </view>
      <view class="form-item">
        <text class="form-label">服务说明</text>
        <textarea
          class="form-textarea"
          value="{{ description }}"
          data-field="description"
          placeholder="填写服务说明"
          bindinput="onInput"
        ></textarea>
      </view>
    </view>

    <view class="admin-section-card">
      <view class="admin-section-title">配置说明</view>
      <view class="form-item">
        <text class="form-label">服务时长</text>
        <input
          class="form-input"
          value="{{ duration }}"
          data-field="duration"
          placeholder="例如：2 小时"
          bindinput="onInput"
        />
      </view>
      <view class="form-item">
        <text class="form-label">价格（元）</text>
        <input
          class="form-input"
          type="digit"
          value="{{ price }}"
          data-field="price"
          placeholder="例如：99.00"
          bindinput="onInput"
        />
      </view>
      <view class="form-item">
        <text class="form-label">状态</text>
        <picker
          mode="selector"
          range="{{ statusOptions }}"
          value="{{ statusIndex }}"
          bindchange="onStatusChange"
        >
          <view class="picker-value">{{ statusOptions[statusIndex] }}</view>
        </picker>
      </view>
      <view class="form-item form-switch-row">
        <text class="form-label">推荐到首页</text>
        <switch
          checked="{{ recommended }}"
          bindchange="onRecommendedChange"
        ></switch>
      </view>
      <view class="form-item">
        <text class="form-label">排序</text>
        <input
          class="form-input"
          type="number"
          value="{{ sort }}"
          data-field="sort"
          placeholder="数字越小越靠前"
          bindinput="onInput"
        />
      </view>
    </view>

    <view class="admin-section-card admin-status-card">
      <view class="admin-section-title">边界说明</view>
      <view class="admin-card-desc">
        服务上下架以后端为准；本页不直接决定订单完成、退款成功、收益结算或财务流水生成。
      </view>
    </view>

    <view class="admin-section-card admin-action-card">
      <view class="admin-section-title">管理操作</view>
      <button
        class="admin-action-button admin-full-button"
        loading="{{ submitting }}"
        disabled="{{ submitting }}"
        bindtap="saveService"
      >
        保存服务
      </button>
    </view>
  </block>
</view>
