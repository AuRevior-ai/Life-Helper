<view class="page">
  <loading-view wx:if="{{ loading }}" text="正在加载资质审核"></loading-view>
  <empty-state
    wx:elif="{{ collectionMissing }}"
    title="资质集合未创建"
    description="请先在云开发数据库创建 merchant_qualifications 集合，再进行资质审核"
  ></empty-state>
  <block wx:elif="{{ qualifications.length }}">
    <view wx:for="{{qualifications}}" wx:key="_id" class="item">
      <text
        >{{item.business_name || item.real_name_mock || item.merchant_id}}</text
      >
      <text>{{item.qualification_status}}</text>
      <button data-id="{{item._id}}" data-result="APPROVED" bindtap="review">
        通过
      </button>
      <button data-id="{{item._id}}" data-result="REJECTED" bindtap="review">
        驳回
      </button>
      <button
        data-id="{{item._id}}"
        data-result="NEED_SUPPLEMENT"
        bindtap="review"
      >
        补充材料
      </button>
    </view>
  </block>
  <empty-state
    wx:else
    title="暂无资质申请"
    description="商家提交资质后，会出现在这里"
  ></empty-state>
</view>
