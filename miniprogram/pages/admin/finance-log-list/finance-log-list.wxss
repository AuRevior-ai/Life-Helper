.finance-card {
  margin-bottom: 20rpx;
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.card-title {
  color: #1f2d2a;
  font-size: 30rpx;
  font-weight: 800;
}

.card-amount {
  color: #b65230;
  font-size: 30rpx;
  font-weight: 800;
}

.card-line {
  margin-top: 12rpx;
  color: #64716d;
  font-size: 24rpx;
}
