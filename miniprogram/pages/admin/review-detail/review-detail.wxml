<view class="page-shell">
  <view class="page-header"><view class="page-title">{{ title }}</view></view>
  <view wx:if="{{ review }}" class="panel">
    <view class="info-row"><text>评分</text><text>{{ review.rating }} 分</text></view>
    <view class="info-row"><text>状态</text><text>{{ review.status }}</text></view>
    <view class="info-row"><text>内容</text><text>{{ review.content }}</text></view>
    <textarea class="form-textarea" placeholder="管理原因" bindinput="onReasonInput"></textarea>
    <button class="primary-button" bindtap="hideReview" loading="{{ submitting }}" disabled="{{ submitting }}">隐藏评价</button>
    <button class="ghost-button" bindtap="restoreReview" loading="{{ submitting }}" disabled="{{ submitting }}">恢复评价</button>
  </view>
</view>
