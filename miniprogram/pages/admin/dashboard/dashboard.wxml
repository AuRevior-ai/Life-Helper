<view class="admin-page dashboard-page">
  <view class="admin-header">
    <view class="admin-title">工作台</view>
    <view class="admin-subtitle">查看今日概览与待处理事项</view>
  </view>

  <view wx:if="{{ loading }}" class="admin-loading-wrap">
    <loading-view text="正在加载看板"></loading-view>
  </view>

  <view class="admin-hero-card dashboard-hero">
    <image
      class="dashboard-hero-bg"
      src="/assets/profile/profile-card-bg-placeholder.png"
      mode="widthFix"
    />
    <view class="dashboard-hero-content">
      <image
        class="dashboard-avatar"
        src="/assets/admin/管理员端头像.png"
        mode="aspectFill"
      />
      <view class="dashboard-hero-main">
        <view class="dashboard-admin-name">{{ adminName }}</view>
        <view class="admin-pill">管理员 · 正常</view>
        <view class="dashboard-hero-note">{{ handledText }}</view>
        <view class="dashboard-compat-text">完成订单金额 {{ completedAmountText }}</view>
      </view>
    </view>
  </view>

  <view class="admin-kpi-grid dashboard-kpi-grid">
    <view class="admin-kpi-card">
      <view class="admin-kpi-icon admin-tone-green">单</view>
      <view class="admin-kpi-label">今日订单</view>
      <view class="admin-kpi-value">{{ stats.orderCount }}</view>
      <view class="admin-kpi-trend">当前统计</view>
    </view>
    <view class="admin-kpi-card">
      <view class="admin-kpi-icon admin-tone-orange">审</view>
      <view class="admin-kpi-label">待审核</view>
      <view class="admin-kpi-value">{{ stats.pendingWorkerCount }}</view>
      <view class="admin-kpi-trend">今日概览</view>
    </view>
    <view class="admin-kpi-card">
      <view class="admin-kpi-icon admin-tone-blue">险</view>
      <view class="admin-kpi-label">风险提醒</view>
      <view class="admin-kpi-value">0</view>
      <view class="admin-kpi-trend">数据待完善</view>
    </view>
  </view>

  <view class="admin-section-card dashboard-todo-card">
    <view class="dashboard-section-head">
      <view class="admin-section-title module-header">待办中心</view>
      <view class="admin-arrow">›</view>
    </view>
    <view class="admin-list module-list">
      <button
        class="admin-list-button"
        data-url="/pages/admin/worker-audit/worker-audit"
        bindtap="goEntry"
      >
        <view class="admin-row-icon admin-tone-green">师</view>
        <view class="admin-row-main">
          <view class="admin-row-title">师傅审核</view>
          <view class="admin-row-desc">处理师傅入驻申请</view>
        </view>
        <view class="admin-badge admin-tone-green">{{ stats.pendingWorkerCount }}</view>
        <view class="admin-arrow">›</view>
      </button>
      <button
        class="admin-list-button"
        data-url="/pages/admin/merchant-list/merchant-list"
        bindtap="goEntry"
      >
        <view class="admin-row-icon admin-tone-green">商</view>
        <view class="admin-row-main">
          <view class="admin-row-title">商家审核</view>
          <view class="admin-row-desc">查看商家入驻与资料</view>
        </view>
        <view class="admin-badge admin-tone-green">0</view>
        <view class="admin-arrow">›</view>
      </button>
      <button
        class="admin-list-button"
        data-url="/pages/admin/after-sale-list/after-sale-list"
        bindtap="goEntry"
      >
        <view class="admin-row-icon admin-tone-blue">售</view>
        <view class="admin-row-main">
          <view class="admin-row-title">售后处理</view>
          <view class="admin-row-desc">处理退款与售后申请</view>
        </view>
        <view class="admin-badge admin-tone-blue">0</view>
        <view class="admin-arrow">›</view>
      </button>
      <button
        class="admin-list-button"
        data-url="/pages/admin/qualification-review/qualification-review"
        bindtap="goEntry"
      >
        <view class="admin-row-icon admin-tone-purple">证</view>
        <view class="admin-row-main">
          <view class="admin-row-title">资质审核</view>
          <view class="admin-row-desc">人工审核资质资料</view>
        </view>
        <view class="admin-badge admin-tone-purple">0</view>
        <view class="admin-arrow">›</view>
      </button>
    </view>
  </view>

  <view class="admin-section-card dashboard-quick-card">
    <view class="admin-section-title">快捷入口</view>
    <view class="admin-quick-grid">
      <button
        class="admin-quick-item"
        data-url="/pages/admin/order-list/order-list"
        bindtap="goEntry"
      >
        <view class="admin-feature-icon admin-tone-green">单</view>
        <text class="admin-quick-label">订单中心</text>
      </button>
      <button
        class="admin-quick-item"
        data-url="/pages/admin/review-center/review-center"
        bindtap="goEntry"
      >
        <view class="admin-feature-icon admin-tone-blue">审</view>
        <text class="admin-quick-label">审核中心</text>
      </button>
      <button
        class="admin-quick-item"
        data-url="/pages/admin/operation-center/operation-center"
        bindtap="goEntry"
      >
        <view class="admin-feature-icon admin-tone-orange">营</view>
        <text class="admin-quick-label">运营中心</text>
      </button>
      <button
        class="admin-quick-item"
        data-url="/pages/admin/finance-log-list/finance-log-list"
        bindtap="goEntry"
      >
        <view class="admin-feature-icon admin-tone-purple">财</view>
        <text class="admin-quick-label">财务流水</text>
      </button>
    </view>
  </view>

  <admin-tab-bar active="dashboard"></admin-tab-bar>
</view>
