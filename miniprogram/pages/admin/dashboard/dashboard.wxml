<view class="page-shell">
  <view class="page-header">
    <view class="page-title">{{ title }}</view>
    <view class="page-subtitle">集中查看运营概况，并进入订单、用户、师傅与服务管理</view>
  </view>

  <loading-view wx:if="{{ loading }}" text="正在加载看板"></loading-view>

  <block wx:else>
    <view class="stats-grid">
      <view class="stat-card panel">
        <view class="stat-label">用户数</view>
        <view class="stat-value">{{ stats.user_count }}</view>
      </view>
      <view class="stat-card panel">
        <view class="stat-label">订单数</view>
        <view class="stat-value">{{ stats.order_count }}</view>
      </view>
      <view class="stat-card panel">
        <view class="stat-label">待审核师傅</view>
        <view class="stat-value">{{ stats.pending_worker_count }}</view>
      </view>
      <view class="stat-card panel wide">
        <view class="stat-label">完成订单金额</view>
        <view class="stat-value amount">{{ completedOrderAmountText }}</view>
      </view>
    </view>

    <view class="section-head">管理入口</view>
    <view class="module-list">
      <view wx:for="{{ entryGroups }}" wx:key="key" class="module-card panel">
        <button class="module-header" data-index="{{ index }}" bindtap="toggleEntryGroup">
          <view class="module-copy">
            <view class="module-title">{{ item.title }}</view>
            <view class="module-desc">{{ item.description }}</view>
          </view>
          <view class="module-meta">{{ item.entries.length }} 项 · {{ item.expanded ? '收起' : '展开' }}</view>
        </button>
        <view wx:if="{{ item.expanded }}" class="module-body">
          <button
            wx:for="{{ item.entries }}"
            wx:for-item="entry"
            wx:key="url"
            class="entry-item"
            data-url="{{ entry.url }}"
            bindtap="goEntry"
          >{{ entry.label }}</button>
        </view>
      </view>
    </view>
  </block>
</view>
