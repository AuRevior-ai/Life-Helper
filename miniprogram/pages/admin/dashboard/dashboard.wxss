.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.stat-card {
  min-height: 138rpx;
  box-sizing: border-box;
}

.stat-card.wide {
  grid-column: span 2;
}

.stat-label {
  color: #64716d;
  font-size: 24rpx;
}

.stat-value {
  margin-top: 14rpx;
  color: #183832;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.2;
}

.stat-value.amount {
  color: #b65230;
}

.module-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.module-card {
  padding: 0;
  overflow: hidden;
}

.module-header {
  display: flex;
  width: 100%;
  min-height: 116rpx;
  margin: 0;
  padding: 22rpx 24rpx;
  align-items: center;
  justify-content: space-between;
  border-radius: 0;
  background: #ffffff;
  color: #1f2d2a;
  line-height: 1.35;
  text-align: left;
}

.module-header::after {
  border: 0;
}

.module-copy {
  flex: 1;
  min-width: 0;
}

.module-title {
  color: #183832;
  font-size: 30rpx;
  font-weight: 700;
}

.module-desc {
  margin-top: 6rpx;
  color: #64716d;
  font-size: 24rpx;
}

.module-meta {
  flex-shrink: 0;
  margin-left: 18rpx;
  color: #1f7a68;
  font-size: 24rpx;
}

.module-body {
  padding: 0 0 10rpx;
  border-top: 1rpx solid #eef2ef;
}

.entry-item {
  display: flex;
  height: 88rpx;
  margin: 0;
  padding: 0 28rpx;
  align-items: center;
  border-radius: 0;
  background: #ffffff;
  color: #1f2d2a;
  font-size: 28rpx;
  line-height: 88rpx;
  text-align: left;
}

.entry-item::after {
  border: 0;
}
