@import "../../../styles/admin-theme.wxss";

.admin-secondary-page,
.admin-secondary-page view,
.admin-secondary-page text,
.admin-secondary-page button,
.admin-secondary-page picker,
.admin-secondary-page textarea,
.admin-secondary-page image,
.admin-secondary-page loading-view,
.admin-secondary-page empty-state {
  box-sizing: border-box;
}

.admin-secondary-page {
  overflow-x: hidden;
  padding: calc(112rpx + env(safe-area-inset-top)) 40rpx
    calc(120rpx + env(safe-area-inset-bottom));
}

.admin-section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.admin-section-note {
  margin-top: 10rpx;
  color: #667085;
  font-size: 25rpx;
  line-height: 36rpx;
}

.admin-status-card {
  border: 1rpx solid #dceee7;
  background: #f8fffb;
}

.admin-status-pill {
  display: inline-flex;
  height: 48rpx;
  max-width: 180rpx;
  padding: 0 18rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
  white-space: nowrap;
}

.admin-status-pill--success {
  background: #eaf8e8;
  color: #16a34a;
}

.admin-status-pill--warning {
  background: #fff2df;
  color: #f08a12;
}

.admin-status-pill--danger {
  background: #ffe8e4;
  color: #c2412f;
}

.admin-status-pill--default {
  background: #f2f4f7;
  color: #667085;
}

.admin-status-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 26rpx;
}

.admin-status-item {
  min-width: 0;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #ffffff;
}

.admin-status-label,
.admin-detail-label,
.admin-form-label {
  color: #667085;
  font-size: 24rpx;
  line-height: 34rpx;
}

.admin-status-value {
  margin-top: 8rpx;
  color: #111827;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.admin-amount {
  color: #f08a12;
}

.admin-detail-row {
  display: flex;
  min-width: 0;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #edf0f2;
}

.admin-detail-row:last-child {
  border-bottom: 0;
}

.admin-detail-row--stack {
  display: block;
}

.admin-detail-value {
  flex: 1;
  min-width: 0;
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
  text-align: right;
}

.admin-detail-row--stack .admin-detail-value {
  display: block;
  margin-top: 10rpx;
  text-align: left;
}

.admin-image-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.admin-finish-image {
  width: 100%;
  height: 156rpx;
  border-radius: 18rpx;
  background: #edf0f2;
}

.admin-action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 24rpx;
}

.admin-form-item {
  margin-top: 26rpx;
}

.admin-form-label {
  display: block;
  margin-bottom: 14rpx;
  font-weight: 800;
}

.admin-picker-value {
  height: 76rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  background: #f6f8fa;
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 76rpx;
}

.admin-wide-button {
  width: 100%;
  margin-top: 22rpx;
}

.admin-error-card {
  color: #b42318;
  font-size: 27rpx;
  line-height: 40rpx;
}
