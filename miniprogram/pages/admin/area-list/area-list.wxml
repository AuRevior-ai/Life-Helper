<view class="admin-page admin-secondary-page">
  <view class="admin-header">
    <view class="admin-title">{{ title }}</view>
    <view class="admin-subtitle">
      管理服务区域、地图中心点和行政区编码，区域匹配仍由后端规则和既有 LBS 基础能力处理。
    </view>
  </view>

  <view class="admin-status-card">
    <view class="admin-card-title">服务区域</view>
    <view class="admin-card-desc">
      本页仅做手动配置和状态查看，不新增路径规划、实时轨迹、ETA、多边形围栏或距离自动加价。
    </view>
  </view>

  <view class="admin-filter-card">
    <view class="admin-filter-title">筛选范围</view>
    <view class="admin-filter-row">
      <view
        wx:for="{{ filterPills }}"
        wx:key="*this"
        class="admin-filter-pill"
      >
        {{ item }}
      </view>
    </view>
  </view>

  <view class="admin-section-card admin-action-card">
    <view class="admin-section-title">管理操作</view>
    <button class="admin-action-button admin-full-button" bindtap="goCreate">
      新增服务区域
    </button>
  </view>

  <view wx:if="{{ errorText }}" class="admin-error-card">{{ errorText }}</view>

  <view class="admin-loading-wrap" wx:if="{{ loading }}">
    <loading-view text="正在加载区域"></loading-view>
  </view>

  <view wx:elif="{{ areas.length }}" class="admin-list-stack">
    <view
      wx:for="{{ areas }}"
      wx:key="_id"
      class="admin-section-card admin-list-card"
    >
      <view class="admin-list-head">
        <view class="admin-list-main">
          <view class="admin-list-title">{{ item.titleText }}</view>
          <view class="admin-list-meta">中心点：{{ item.locationText }}</view>
        </view>
        <view class="admin-status-pill {{ item.statusClass }}">
          {{ item.statusText }}
        </view>
      </view>
      <view class="admin-list-desc">行政区编码：{{ item.adcodeText }}</view>
      <view class="admin-action-row">
        <button
          class="admin-outline-button"
          data-id="{{ item._id }}"
          bindtap="goEdit"
        >
          编辑
        </button>
        <button
          class="admin-outline-button"
          data-id="{{ item._id }}"
          data-status="{{ item.status }}"
          loading="{{ submittingId === item._id }}"
          disabled="{{ submittingId === item._id }}"
          bindtap="toggleStatus"
        >
          {{ item.nextStatusText }}
        </button>
      </view>
    </view>
  </view>

  <empty-state
    wx:else
    title="{{ collectionMissing ? '服务区域集合未创建' : '暂无服务区域' }}"
    description="{{ collectionMissing ? '请先在云开发数据库创建 service_areas 集合，然后再新增服务区域' : '新增服务区域后，地址和服务范围可按地图中心点、行政区或小区匹配' }}"
  ></empty-state>
</view>
