<view class="page-shell">
  <view class="page-header">
    <view class="page-title">{{ title }}</view>
  </view>

  <view class="panel">
    <view class="form-item">
      <text class="form-label">城市</text>
      <input class="form-input" value="{{ form.city }}" data-field="city" bindinput="handleInput" />
    </view>
    <view class="form-item">
      <text class="form-label">区县</text>
      <input class="form-input" value="{{ form.district }}" data-field="district" bindinput="handleInput" />
    </view>
    <view class="form-item">
      <text class="form-label">街道</text>
      <input class="form-input" value="{{ form.street }}" data-field="street" bindinput="handleInput" />
    </view>
    <view class="form-item">
      <text class="form-label">小区</text>
      <input class="form-input" value="{{ form.community }}" data-field="community" bindinput="handleInput" />
    </view>
  </view>

  <button class="primary-button" loading="{{ saving }}" disabled="{{ saving }}" bindtap="handleSave">保存区域</button>
</view>
