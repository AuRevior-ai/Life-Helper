.order-list {
  display: grid;
  gap: 18rpx;
}

.filter-panel {
  display: grid;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.filter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  color: #64716d;
  font-size: 25rpx;
}

.picker-value,
.filter-input {
  min-width: 240rpx;
  padding: 14rpx 18rpx;
  border-radius: 8rpx;
  background: #f6f8f5;
  color: #1f2d2a;
  font-size: 25rpx;
  text-align: right;
}

.order-card {
  display: block;
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.service-name {
  color: #183832;
  font-size: 30rpx;
  font-weight: 800;
}

.status-tag {
  flex: 0 0 auto;
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
  background: #e8f2ee;
  color: #1f7a68;
  font-size: 22rpx;
  font-weight: 700;
}

.order-line {
  margin-top: 12rpx;
  color: #64716d;
  font-size: 24rpx;
  line-height: 1.45;
}
