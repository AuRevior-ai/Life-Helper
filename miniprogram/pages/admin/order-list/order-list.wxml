<view class="page-shell">
  <view class="page-header">
    <view class="page-title">{{ title }}</view>
    <view class="page-subtitle">查看平台订单，并进入详情手动调整状态</view>
  </view>

  <view class="filter-panel panel">
    <view class="filter-row">
      <text>状态</text>
      <picker mode="selector" range="{{ statusLabels }}" value="{{ selectedStatusIndex }}" bindchange="onStatusChange">
        <view class="picker-value">{{ statusLabels[selectedStatusIndex] }}</view>
      </picker>
    </view>
    <view class="filter-row">
      <text>分类 ID</text>
      <input class="filter-input" value="{{ categoryId }}" placeholder="可选" bindinput="onCategoryInput" />
    </view>
    <view class="filter-row">
      <text>关键词</text>
      <input class="filter-input" value="{{ keyword }}" placeholder="订单号/服务/联系人" bindinput="onKeywordInput" />
    </view>
    <button class="ghost-button" bindtap="applyFilters">筛选</button>
  </view>

  <loading-view wx:if="{{ loading && !orders.length }}" text="正在加载订单"></loading-view>

  <view wx:elif="{{ orders.length }}" class="order-list">
    <view
      wx:for="{{ orders }}"
      wx:key="_id"
      class="order-card panel"
      data-id="{{ item._id }}"
      bindtap="goDetail"
    >
      <view class="card-top">
        <view class="service-name">{{ item.service_name || item.serviceName }}</view>
        <view class="status-tag">{{ item.statusText }}</view>
      </view>
      <view class="order-line">订单号：{{ item.order_no || item._id }}</view>
      <view class="order-line">用户：{{ item.contact_name || item.user_id }}</view>
      <view class="order-line">金额：{{ item.priceText }}</view>
    </view>
  </view>

  <empty-state
    wx:else
    title="暂无订单"
    description="用户下单后会显示在这里"
  ></empty-state>
</view>
