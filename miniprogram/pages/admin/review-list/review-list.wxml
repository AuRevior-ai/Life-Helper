<view class="page-shell">
  <view class="page-header"><view class="page-title">{{ title }}</view></view>
  <loading-view wx:if="{{ loading }}" text="正在加载评价"></loading-view>
  <view wx:elif="{{ reviews.length }}">
    <view wx:for="{{ reviews }}" wx:key="_id" class="panel list-card" data-id="{{ item._id }}" bindtap="goDetail">
      <view>{{ item.service_name }} · {{ item.rating }} 分 · {{ item.status }}</view>
      <view class="muted">{{ item.content }}</view>
    </view>
  </view>
  <empty-state wx:else title="暂无评价" description="暂无可管理评价"></empty-state>
</view>
