<view class="page-shell">
  <view class="page-header"><view class="page-title">{{ title }}</view></view>
  <loading-view wx:if="{{ loading }}" text="正在加载评价"></loading-view>
  <view wx:elif="{{ groupedReviews.length }}">
    <view wx:for="{{ groupedReviews }}" wx:key="workerId" wx:for-item="group" class="worker-group">
      <view class="worker-group__title">师傅：{{ group.workerName }}</view>
      <view
        wx:for="{{ group.reviews }}"
        wx:key="_id"
        wx:for-item="item"
        class="panel list-card"
        data-id="{{ item._id }}"
        bindtap="goDetail"
      >
        <view>{{ item.service_name }} · {{ item.rating }} 分 · {{ item.status }}</view>
        <view class="muted">{{ item.content }}</view>
      </view>
    </view>
  </view>
  <empty-state wx:else title="暂无评价" description="暂无可管理评价"></empty-state>
</view>
