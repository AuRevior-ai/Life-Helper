<view class="page-shell">
  <view class="page-header">
    <view class="page-title">{{ title }}</view>
  </view>

  <loading-view wx:if="{{ loading }}" text="正在加载日志"></loading-view>
  <block wx:elif="{{ logs.length }}">
    <view wx:for="{{ logs }}" wx:key="_id" class="panel">
      <view class="section-title">{{ item.action }}</view>
      <view class="muted-text">订单：{{ item.order_no || item.order_id }}</view>
      <view class="muted-text"
        >从 {{ item.from_status }} 到 {{ item.to_status }}</view
      >
      <view class="muted-text">原因：{{ item.reason }}</view>
    </view>
  </block>
  <empty-state
    wx:else
    title="{{ collectionMissing ? '派单日志集合未创建' : '暂无派单日志' }}"
    description="{{ collectionMissing ? '请先在云开发数据库创建 dispatch_logs 集合，后续接单和指派会写入日志' : '接单、指派和回流后会生成记录' }}"
  ></empty-state>
</view>
