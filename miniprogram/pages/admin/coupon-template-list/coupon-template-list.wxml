<view class="page-shell">
  <view class="page-header">
    <view class="page-title">{{ title }}</view>
    <view class="page-subtitle">创建和查看基础优惠券模板</view>
  </view>

  <button class="primary-button" bindtap="goCreate">新增优惠券</button>

  <loading-view wx:if="{{ loading }}" text="正在加载优惠券"></loading-view>

  <block wx:elif="{{ templates.length }}">
    <view
      wx:for="{{ templates }}"
      wx:key="_id"
      class="panel coupon-card"
      data-id="{{ item._id }}"
      bindtap="goEdit"
    >
      <view class="card-top">
        <view class="card-title">{{ item.name }}</view>
        <view class="card-amount">{{ item.amountText }}</view>
      </view>
      <view class="card-line">{{ item.typeText }} · {{ item.statusText }}</view>
      <view class="card-line">已领 {{ item.received_quantity || 0 }} / 已用 {{ item.used_quantity || 0 }}</view>
    </view>
  </block>

  <empty-state wx:else title="暂无优惠券模板" description="新增后用户可在领券中心领取"></empty-state>
</view>

