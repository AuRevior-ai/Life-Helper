@import "../../../styles/admin-theme.wxss";

.admin-secondary-page,
.admin-secondary-page view,
.admin-secondary-page text,
.admin-secondary-page button,
.admin-secondary-page textarea,
.admin-secondary-page loading-view,
.admin-secondary-page empty-state {
  box-sizing: border-box;
}

.admin-secondary-page {
  overflow-x: hidden;
  padding: calc(112rpx + env(safe-area-inset-top)) 40rpx
    calc(120rpx + env(safe-area-inset-bottom));
}

.admin-section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.admin-section-note {
  margin-top: 10rpx;
  color: #667085;
  font-size: 25rpx;
  line-height: 36rpx;
}

.admin-status-card {
  border: 1rpx solid #dceee7;
  background: #f8fffb;
}

.admin-status-pill {
  display: inline-flex;
  height: 48rpx;
  padding: 0 18rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
  white-space: nowrap;
}

.admin-status-pill--warning {
  background: #fff2df;
  color: #f08a12;
}

.admin-status-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 26rpx;
}

.admin-status-item {
  min-width: 0;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #ffffff;
}

.admin-status-label,
.admin-detail-label {
  color: #667085;
  font-size: 24rpx;
  line-height: 34rpx;
}

.admin-status-value {
  margin-top: 8rpx;
  color: #111827;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.admin-amount {
  color: #f08a12;
}

.admin-detail-row,
.admin-log-row {
  display: flex;
  min-width: 0;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf0f2;
}

.admin-detail-row:last-child,
.admin-log-row:last-child {
  border-bottom: 0;
}

.admin-detail-row--stack {
  display: block;
}

.admin-detail-value,
.admin-log-row text {
  flex: 1;
  min-width: 0;
  color: #111827;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 38rpx;
  text-align: right;
}

.admin-detail-row--stack .admin-detail-value {
  display: block;
  margin-top: 10rpx;
  text-align: left;
}

.admin-form-textarea {
  width: 100%;
  min-height: 170rpx;
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: #f6f8fa;
  color: #111827;
  font-size: 28rpx;
  line-height: 40rpx;
}

.admin-action-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 24rpx;
}

.admin-action-row .admin-action-button,
.admin-action-row .admin-danger-button {
  width: 100%;
  min-width: 0;
}

.admin-danger-button {
  display: flex;
  height: 64rpx;
  margin: 0;
  padding: 0 28rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #f3b6ac;
  border-radius: 999rpx;
  background: #fff7f5;
  color: #b42318;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 64rpx;
  white-space: nowrap;
}

.admin-danger-button::after {
  border: 0;
}

.admin-error-card {
  color: #b42318;
  font-size: 27rpx;
  line-height: 40rpx;
}
