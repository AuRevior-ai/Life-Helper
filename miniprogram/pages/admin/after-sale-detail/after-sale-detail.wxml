<view class="page-shell">
  <view class="page-header">
    <view class="page-title">{{ title }}</view>
    <view class="page-subtitle">审核通过后将立即执行模拟退款</view>
  </view>

  <loading-view wx:if="{{ loading }}" text="正在加载售后"></loading-view>

  <block wx:elif="{{ afterSale }}">
    <view class="panel detail-panel">
      <view class="detail-row"><text>售后单号</text><text>{{ afterSale.after_sale_no }}</text></view>
      <view class="detail-row"><text>订单号</text><text>{{ afterSale.order_no }}</text></view>
      <view class="detail-row"><text>状态</text><text>{{ statusText }}</text></view>
      <view class="detail-row"><text>退款状态</text><text>{{ refundStatusText }}</text></view>
      <view class="detail-row"><text>退款金额</text><text>{{ amountText }}</text></view>
      <view class="detail-row"><text>原因</text><text>{{ afterSale.reason }}</text></view>
    </view>

    <view class="panel remark-panel">
      <view class="form-label">审核备注</view>
      <textarea value="{{ adminRemark }}" bindinput="handleRemarkInput" placeholder="填写审核意见"></textarea>
    </view>

    <button
      wx:if="{{ afterSale.status === 'pending' }}"
      class="primary-button"
      data-status="approved"
      loading="{{ submitting }}"
      disabled="{{ submitting }}"
      bindtap="reviewAfterSale"
    >通过并模拟退款</button>

    <button
      wx:if="{{ afterSale.status === 'pending' }}"
      class="ghost-button"
      data-status="rejected"
      loading="{{ submitting }}"
      disabled="{{ submitting }}"
      bindtap="reviewAfterSale"
    >拒绝申请</button>
  </block>

  <empty-state wx:else title="售后不存在" description="请返回列表重新查看"></empty-state>
</view>
