@import "../../../styles/admin-theme.wxss";

.review-center-page,
.review-center-page view,
.review-center-page text,
.review-center-page loading-view,
.review-center-page admin-tab-bar {
  box-sizing: border-box;
}

.review-center-page {
  overflow-x: hidden;
  padding: calc(112rpx + env(safe-area-inset-top)) 40rpx
    calc(230rpx + env(safe-area-inset-bottom));
  background: #f7f9fa;
}

.review-center-page .admin-header {
  margin-bottom: 38rpx;
}

.review-center-page .admin-title {
  font-size: 54rpx;
  line-height: 64rpx;
  letter-spacing: 0;
}

.review-center-page .admin-subtitle {
  margin-top: 16rpx;
  font-size: 29rpx;
  line-height: 42rpx;
}

.review-center-page .admin-kpi-grid {
  gap: 24rpx;
  margin-top: 0;
}

.review-center-page .admin-kpi-card {
  display: grid;
  min-width: 0;
  min-height: 132rpx;
  grid-template-columns: 66rpx minmax(0, 1fr);
  align-items: center;
  column-gap: 18rpx;
  padding: 22rpx 18rpx;
  border-radius: 28rpx;
}

.review-center-page .admin-kpi-icon {
  width: 66rpx;
  height: 66rpx;
  font-size: 28rpx;
}

.admin-kpi-copy {
  min-width: 0;
}

.review-center-page .admin-kpi-label {
  overflow: hidden;
  margin-top: 0;
  color: #566274;
  font-size: 27rpx;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.review-center-page .admin-kpi-value {
  margin-top: 6rpx;
  font-size: 42rpx;
  line-height: 48rpx;
}

.admin-kpi-value--green {
  color: #16a34a;
}

.admin-kpi-value--blue {
  color: #2f7be7;
}

.review-center-page .admin-section-card {
  width: 100%;
  max-width: 100%;
  overflow: hidden;
  margin-top: 28rpx;
  padding: 32rpx 28rpx;
  border-radius: 32rpx;
}

.review-center-page .admin-section-title {
  font-size: 31rpx;
  line-height: 42rpx;
}

.review-list-card {
  padding-bottom: 18rpx;
}

.review-center-page .admin-list {
  margin-top: 18rpx;
}

.review-center-page .admin-list-row {
  display: flex;
  width: 100%;
  min-width: 0;
  min-height: 122rpx;
  align-items: center;
  gap: 22rpx;
  border-bottom: 0;
  background: #ffffff;
}

.review-center-page .admin-list-row:not(:last-child) .admin-row-main {
  border-bottom: 1rpx solid #edf0f2;
}

.review-center-page .admin-list-button {
  padding: 0;
}

.review-center-page .admin-row-icon {
  width: 72rpx;
  height: 72rpx;
  font-size: 29rpx;
}

.review-center-page .admin-row-main {
  display: flex;
  min-width: 0;
  min-height: 122rpx;
  flex: 1;
  justify-content: center;
  flex-direction: column;
}

.review-center-page .admin-row-title {
  overflow: visible;
  color: #111827;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 42rpx;
  white-space: nowrap;
}

.review-center-page .admin-row-desc {
  overflow: hidden;
  margin-top: 6rpx;
  color: #667085;
  font-size: 25rpx;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.review-center-page .admin-badge {
  min-width: 64rpx;
  height: 42rpx;
  margin-left: auto;
  padding: 0 16rpx;
  flex-shrink: 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 42rpx;
  text-align: center;
  white-space: nowrap;
}

.review-center-page .admin-arrow {
  margin-left: 12rpx;
  flex-shrink: 0;
  color: #8a95a6;
  font-size: 42rpx;
}

.review-quick-card {
  padding: 28rpx 18rpx 30rpx;
}

.review-center-page .admin-quick-grid {
  display: grid;
  width: 100%;
  max-width: 100%;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
  margin-top: 0;
}

.review-center-page .admin-quick-item {
  display: flex;
  min-width: 0;
  min-height: 150rpx;
  margin: 0;
  padding: 0 6rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  background: #ffffff;
  color: #111827;
  text-align: center;
}

.review-center-page .admin-feature-icon {
  width: 76rpx;
  height: 76rpx;
  margin: 0 0 18rpx;
  font-size: 30rpx;
}

.review-center-page .admin-quick-label {
  width: 100%;
  max-width: 100%;
  overflow: hidden;
  color: #344054;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}
