@import "../../../styles/admin-theme.wxss";

.admin-secondary-page {
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
}

.admin-status-card,
.admin-filter-card,
.admin-error-card {
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 38rpx rgba(17, 24, 39, 0.05);
}

.admin-status-card {
  border-left: 8rpx solid #7c4de6;
}

.admin-card-title,
.admin-filter-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.admin-card-desc,
.admin-list-desc {
  margin-top: 12rpx;
  color: #667085;
  font-size: 25rpx;
  line-height: 36rpx;
}

.admin-filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 18rpx;
}

.admin-filter-pill,
.admin-status-pill {
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 44rpx;
  white-space: nowrap;
}

.admin-filter-pill {
  background: #f2f4f7;
  color: #475467;
}

.admin-status-pill.is-active {
  background: #eaf8e8;
  color: #16a34a;
}

.form-textarea {
  width: 100%;
  min-height: 150rpx;
  box-sizing: border-box;
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: #f7f9fa;
  color: #111827;
  font-size: 27rpx;
  line-height: 38rpx;
}

.admin-list-stack {
  display: grid;
  gap: 20rpx;
}

.admin-list-card {
  margin-top: 0;
}

.admin-list-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.admin-list-main {
  min-width: 0;
  flex: 1;
}

.admin-list-title {
  color: #111827;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.admin-list-meta {
  margin-top: 10rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 34rpx;
}

.admin-card-button {
  width: 100%;
  margin-top: 22rpx;
}

.admin-error-card {
  background: #fff4ed;
  color: #b54708;
  font-size: 25rpx;
  line-height: 36rpx;
}
