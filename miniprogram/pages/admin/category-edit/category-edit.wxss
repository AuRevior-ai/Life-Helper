@import "../../../styles/admin-theme.wxss";

.admin-secondary-page {
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
}

.admin-status-card,
.admin-error-card {
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 38rpx rgba(17, 24, 39, 0.05);
}

.admin-status-card {
  border-left: 8rpx solid #16a34a;
}

.admin-card-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.admin-card-desc {
  margin-top: 12rpx;
  color: #667085;
  font-size: 25rpx;
  line-height: 36rpx;
}

.form-item {
  margin-top: 24rpx;
}

.form-label {
  display: block;
  color: #344054;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.form-input,
.form-textarea,
.picker-value {
  width: 100%;
  box-sizing: border-box;
  margin-top: 12rpx;
  border-radius: 18rpx;
  background: #f7f9fa;
  color: #111827;
  font-size: 27rpx;
}

.form-input,
.picker-value {
  height: 80rpx;
  padding: 0 22rpx;
  line-height: 80rpx;
}

.form-textarea {
  min-height: 150rpx;
  padding: 20rpx 22rpx;
  line-height: 38rpx;
}

.admin-action-card {
  padding-bottom: 28rpx;
}

.admin-full-button {
  width: 100%;
  margin-top: 22rpx;
}

.admin-error-card {
  background: #fff4ed;
  color: #b54708;
  font-size: 25rpx;
  line-height: 36rpx;
}
