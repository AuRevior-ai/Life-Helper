<view class="page-shell">
  <view class="page-header"><view class="page-title">{{ title }}</view></view>
  <loading-view wx:if="{{ loading }}" text="正在加载申诉"></loading-view>
  <view wx:elif="{{ groupedAppeals.length }}">
    <view
      wx:for="{{ groupedAppeals }}"
      wx:key="workerId"
      wx:for-item="group"
      class="worker-group"
    >
      <view class="worker-group__title">师傅：{{ group.workerName }}</view>
      <view
        wx:for="{{ group.appeals }}"
        wx:key="_id"
        wx:for-item="item"
        class="panel list-card"
        data-id="{{ item._id }}"
        bindtap="goDetail"
      >
        <view>{{ item.reason }} · {{ item.status }}</view>
        <view class="muted">{{ item.order_no }}</view>
      </view>
    </view>
  </view>
  <empty-state
    wx:else
    title="暂无申诉"
    description="师傅提交差评申诉后会展示在这里"
  ></empty-state>
</view>
