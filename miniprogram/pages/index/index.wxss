/* page */
.home-page {
  min-height: 100vh;
  padding: 96rpx 40rpx 170rpx;
  box-sizing: border-box;
  background: #f7f8fa;
  color: #111827;
  font-family:
    -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial,
    sans-serif;
}

.home-section-card {
  margin-top: 28rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(31, 41, 55, 0.06);
  box-sizing: border-box;
}

.home-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.home-section-title {
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.3;
}

.home-section-more {
  color: #8a8f98;
  font-size: 26rpx;
  line-height: 1.3;
}

/* header */
.home-header {
  position: relative;
}

.home-greeting {
  color: #111827;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.3;
}

/* location */
.home-location-pill {
  display: inline-flex;
  max-width: 520rpx;
  height: 56rpx;
  margin-top: 24rpx;
  padding: 0 22rpx;
  align-items: center;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.05);
  box-sizing: border-box;
}

.home-location-icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  flex: 0 0 28rpx;
  border-radius: 50% 50% 50% 8rpx;
  background: #18a058;
  transform: rotate(-45deg);
}

.home-location-icon::after {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ffffff;
  content: "";
}

.home-location-label {
  margin-left: 14rpx;
  color: #6b7280;
  font-size: 26rpx;
  white-space: nowrap;
}

.home-location-value {
  margin-left: 18rpx;
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
  white-space: nowrap;
}

.home-chevron {
  margin-left: 12rpx;
  color: #8a8f98;
  font-size: 34rpx;
  line-height: 1;
}

/* search */
.home-search-box {
  display: flex;
  height: 84rpx;
  margin-top: 26rpx;
  padding: 0 32rpx;
  align-items: center;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.08);
  box-sizing: border-box;
}

.home-search-icon {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
  border: 5rpx solid #6b7280;
  border-radius: 50%;
  box-sizing: border-box;
}

.home-search-icon::after {
  position: absolute;
  right: -9rpx;
  bottom: -7rpx;
  width: 15rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: #6b7280;
  content: "";
  transform: rotate(45deg);
}

.home-search-placeholder {
  margin-left: 24rpx;
  color: #9ca3af;
  font-size: 31rpx;
}

/* banner */
.home-banner-card {
  position: relative;
  height: 216rpx;
  margin-top: 28rpx;
  padding: 32rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ecf9e8 0%, #dff5db 100%);
  box-sizing: border-box;
}

.home-banner-bg {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
  display: block;
  width: 100%;
  height: 100%;
}

.home-banner-copy {
  position: relative;
  z-index: 2;
}

.home-banner-title {
  color: #128a43;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.08;
}

.home-banner-subtitle {
  margin-top: 14rpx;
  color: #111827;
  font-size: 28rpx;
  line-height: 1.3;
}

.home-banner-badges {
  display: flex;
  gap: 26rpx;
  margin-top: 24rpx;
}

.home-banner-badge {
  display: flex;
  align-items: center;
  color: #2f7d48;
  font-size: 23rpx;
  font-weight: 600;
  white-space: nowrap;
}

.home-badge-icon {
  position: relative;
  width: 24rpx;
  height: 24rpx;
  margin-right: 9rpx;
  border: 3rpx solid #18a058;
  border-radius: 50%;
  box-sizing: border-box;
}

.home-badge-icon::after {
  position: absolute;
  top: 4rpx;
  left: 5rpx;
  width: 9rpx;
  height: 5rpx;
  border-left: 3rpx solid #18a058;
  border-bottom: 3rpx solid #18a058;
  content: "";
  transform: rotate(-45deg);
}

.home-banner-dots {
  position: absolute;
  z-index: 2;
  left: 50%;
  bottom: 14rpx;
  display: flex;
  gap: 14rpx;
  transform: translateX(-50%);
}

.home-banner-dot {
  width: 16rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: #d1d5db;
}

.home-banner-dot--active {
  width: 28rpx;
  background: #16a34a;
}

/* category */
.home-category-card {
  min-height: 236rpx;
}

.home-category-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 26rpx;
}

.home-category-item {
  display: flex;
  min-width: 0;
  align-items: center;
  flex-direction: column;
}

.home-category-icon {
  position: relative;
  display: flex;
  width: 110rpx;
  height: 110rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.home-category-icon--cleaning {
  background: #e8f7ea;
}

.home-category-icon--repair {
  background: #eaf3ff;
}

.home-category-icon--pet {
  background: #fff2e6;
}

.home-category-image {
  display: block;
  width: 86rpx;
  height: 86rpx;
}

.home-category-name {
  margin-top: 14rpx;
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.3;
}

/* services */
.home-common-card {
  padding-bottom: 20rpx;
}

.home-common-list {
  margin-top: 18rpx;
}

.home-service-row {
  display: flex;
  min-height: 124rpx;
  padding: 10rpx;
  align-items: center;
  overflow: hidden;
  border: 1rpx solid #eef0f2;
  border-radius: 16rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.home-service-row + .home-service-row {
  margin-top: 14rpx;
}

.home-service-cover {
  width: 176rpx;
  height: 96rpx;
  flex: 0 0 176rpx;
  overflow: hidden;
  border-radius: 10rpx;
  background: #eef2f3;
}

.home-service-cover-image {
  display: block;
  width: 100%;
  height: 100%;
}

.home-service-info {
  min-width: 0;
  flex: 1;
  margin-left: 20rpx;
}

.home-service-title {
  overflow: hidden;
  color: #111827;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-service-desc {
  overflow: hidden;
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 25rpx;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-service-duration {
  display: flex;
  margin-top: 8rpx;
  align-items: center;
  color: #9ca3af;
  font-size: 23rpx;
  line-height: 1.2;
}

.home-clock-icon {
  position: relative;
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
  border: 3rpx solid #9ca3af;
  border-radius: 50%;
  box-sizing: border-box;
}

.home-clock-icon::before {
  position: absolute;
  top: 4rpx;
  left: 9rpx;
  width: 3rpx;
  height: 7rpx;
  border-radius: 999rpx;
  background: #9ca3af;
  content: "";
}

.home-clock-icon::after {
  position: absolute;
  top: 10rpx;
  left: 9rpx;
  width: 6rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #9ca3af;
  content: "";
}

.home-service-action {
  display: flex;
  width: 124rpx;
  min-width: 0;
  flex: 0 0 124rpx;
  align-items: flex-end;
  flex-direction: column;
}

.home-service-price {
  color: #ff6a00;
  line-height: 1.1;
  white-space: nowrap;
}

.home-price-main {
  font-size: 34rpx;
  font-weight: 900;
}

.home-price-suffix {
  margin-left: 3rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.home-book-button {
  display: block;
  width: 112rpx;
  max-width: 100%;
  min-width: 0;
  height: 50rpx;
  margin: 16rpx 0 0;
  padding: 0;
  overflow: hidden;
  border: 0;
  border-radius: 999rpx;
  background: #16a34a;
  box-sizing: border-box;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 50rpx;
  text-overflow: clip;
  white-space: nowrap;
}

.home-book-button::after {
  border: 0;
}

/* guarantee */
.home-guarantee-strip {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  min-height: 86rpx;
  margin-top: 20rpx;
  padding: 14rpx 18rpx;
  border-radius: 20rpx;
  background: linear-gradient(90deg, #effaf0, #f5fbf3);
  box-sizing: border-box;
}

.home-guarantee-item {
  position: relative;
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: center;
}

.home-guarantee-item + .home-guarantee-item::before {
  position: absolute;
  left: 0;
  width: 1rpx;
  height: 48rpx;
  background: rgba(22, 163, 74, 0.18);
  content: "";
}

.home-guarantee-icon {
  position: relative;
  width: 36rpx;
  height: 36rpx;
  flex: 0 0 36rpx;
  border: 4rpx solid #18a058;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.home-guarantee-icon::after {
  position: absolute;
  top: 8rpx;
  left: 7rpx;
  width: 14rpx;
  height: 8rpx;
  border-left: 4rpx solid #18a058;
  border-bottom: 4rpx solid #18a058;
  content: "";
  transform: rotate(-45deg);
}

.home-guarantee-copy {
  min-width: 0;
  margin-left: 12rpx;
}

.home-guarantee-title {
  overflow: hidden;
  color: #15803d;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.15;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-guarantee-desc {
  overflow: hidden;
  margin-top: 4rpx;
  color: #6b7280;
  font-size: 20rpx;
  line-height: 1.15;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* tabbar compatibility */
.home-page {
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
}
