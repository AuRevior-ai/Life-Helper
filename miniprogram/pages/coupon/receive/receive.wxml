<view class="coupon-receive-page ui-page ui-page--dense">
  <view class="ui-header">
    <view class="ui-title">{{ title }}</view>
    <view class="ui-subtitle">领取后可在下单页选择使用</view>
  </view>

  <loading-view wx:if="{{ loading }}" text="正在加载可领券"></loading-view>

  <block wx:elif="{{ templates.length }}">
    <view wx:for="{{ templates }}" wx:key="_id" class="ui-card coupon-card">
      <view class="card-title">{{ item.name }}</view>
      <view class="card-line">{{ item.typeText }} · {{ item.amountText }}</view>
      <button
        class="receive-button ui-primary-button"
        data-id="{{ item._id }}"
        bindtap="receiveCoupon"
      >
        领取
      </button>
    </view>
  </block>

  <empty-state
    wx:else
    title="暂无可领取优惠券"
    description="平台发布后会显示在这里"
  ></empty-state>
</view>
