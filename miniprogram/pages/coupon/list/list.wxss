@import "../../../styles/ui-kit.wxss";

.coupon-action {
  width: 100%;
  height: 76rpx;
  margin-bottom: 26rpx;
  font-size: 28rpx;
  line-height: 76rpx;
}

.coupon-card {
  margin-bottom: 22rpx;
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.card-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 800;
}

.card-amount {
  font-size: 30rpx;
}

.card-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 24rpx;
}
