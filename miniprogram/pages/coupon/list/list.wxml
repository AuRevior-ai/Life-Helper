<view class="page-shell">
  <view class="page-header">
    <view class="page-title">{{ title }}</view>
    <view class="page-subtitle">一笔订单最多使用一张优惠券</view>
  </view>

  <button class="primary-button" bindtap="goReceive">领取优惠券</button>

  <loading-view wx:if="{{ loading }}" text="正在加载优惠券"></loading-view>

  <block wx:elif="{{ coupons.length }}">
    <view wx:for="{{ coupons }}" wx:key="_id" class="panel coupon-card">
      <view class="card-top">
        <view class="card-title">{{ item.coupon_name }}</view>
        <view class="card-amount">{{ item.amountText }}</view>
      </view>
      <view class="card-line">状态：{{ item.statusText }}</view>
      <view class="card-line">有效期至：{{ item.valid_end_at }}</view>
    </view>
  </block>

  <empty-state
    wx:else
    title="暂无优惠券"
    description="可前往领券中心领取"
  ></empty-state>
</view>
