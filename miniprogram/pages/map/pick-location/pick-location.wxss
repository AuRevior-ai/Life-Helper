@import "../../../styles/ui-kit.wxss";

.title {
  display: block;
  margin-bottom: 16rpx;
}
.hint {
  display: block;
  line-height: 1.6;
  margin-bottom: 20rpx;
}
input {
  display: block;
  width: 100%;
  padding: 18rpx 20rpx;
  margin-bottom: 16rpx;
  background: #f7f8fa;
  border-radius: 18rpx;
  box-sizing: border-box;
  color: #111827;
}

.map-button {
  width: 100%;
  height: 76rpx;
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 76rpx;
}
