<view class="map-page ui-page ui-page--dense">
  <view class="ui-card map-panel">
    <text class="ui-title title">地图选点</text>
    <text class="ui-subtitle hint"
      >当前页面为基础选点入口。真实地图组件和地图 key
      需按配置文档启用；定位失败时可手动填写坐标。</text
    >
    <input
      value="{{point.latitude}}"
      data-field="latitude"
      bindinput="onInput"
      placeholder="纬度"
    />
    <input
      value="{{point.longitude}}"
      data-field="longitude"
      bindinput="onInput"
      placeholder="经度"
    />
    <input
      value="{{point.map_address}}"
      data-field="map_address"
      bindinput="onInput"
      placeholder="地图地址"
    />
    <input
      value="{{point.map_poi_name}}"
      data-field="map_poi_name"
      bindinput="onInput"
      placeholder="POI 名称"
    />
    <input
      value="{{point.adcode}}"
      data-field="adcode"
      bindinput="onInput"
      placeholder="adcode"
    />
    <button class="map-button ui-primary-button" bindtap="confirmPoint">
      确认位置
    </button>
  </view>
</view>
