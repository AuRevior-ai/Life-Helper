<view class="page-shell">
  <view class="page-header">
    <view class="page-title">{{ title }}</view>
  </view>
  <view class="panel">
    <view class="section-title">接单状态</view>
    <picker mode="selector" range="{{ statusLabels }}" value="{{ selectedStatusIndex }}" bindchange="onOnlineStatusChange">
      <view class="form-input">{{ onlineStatusText }}</view>
    </picker>
    <view class="muted-text">暂停接单不会影响已有订单</view>
  </view>
  <view class="panel muted-text">
    服务小区：{{ worker.service_area || '未配置' }}
  </view>
  <button class="primary-button" bindtap="goReviewList">用户评价</button>
  <button class="primary-button" bindtap="goMessageList">消息中心</button>
</view>
