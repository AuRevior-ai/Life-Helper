.worker-profile-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 88rpx 34rpx calc(230rpx + env(safe-area-inset-bottom));
  background: #f8faf9;
  color: #111827;
  font-family:
    -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial,
    sans-serif;
}

.worker-profile-header {
  margin-bottom: 28rpx;
}

.worker-profile-title {
  color: #05070a;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 54rpx;
}

.worker-profile-subtitle {
  margin-top: 14rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 34rpx;
}

.worker-card {
  box-sizing: border-box;
  margin-top: 22rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(31, 41, 55, 0.07);
}

.profile-card {
  display: flex;
  min-height: 188rpx;
  align-items: center;
  padding: 26rpx 28rpx 26rpx 24rpx;
}

.master-avatar {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  flex: 0 0 150rpx;
  overflow: hidden;
  border-radius: 50%;
  background: linear-gradient(135deg, #eaf8e8 0%, #dff4e4 100%);
}

.master-avatar__image {
  width: 100%;
  height: 100%;
  display: block;
}

.master-avatar__badge {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  width: 34rpx;
  height: 34rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  background: #16a34a;
}

.master-avatar__badge::before,
.master-avatar__badge::after {
  position: absolute;
  background: #ffffff;
  border-radius: 999rpx;
  content: "";
}

.master-avatar__badge::before {
  top: 16rpx;
  left: 7rpx;
  width: 8rpx;
  height: 4rpx;
  transform: rotate(45deg);
}

.master-avatar__badge::after {
  top: 13rpx;
  left: 13rpx;
  width: 16rpx;
  height: 4rpx;
  transform: rotate(-45deg);
}

.profile-main {
  min-width: 0;
  flex: 1;
  margin-left: 30rpx;
}

.profile-name-row {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 18rpx;
}

.profile-name {
  overflow: hidden;
  max-width: 210rpx;
  color: #05070a;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 44rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.verified-pill,
.status-pill {
  display: inline-flex;
  height: 46rpx;
  box-sizing: border-box;
  align-items: center;
  border-radius: 12rpx;
  background: #e8f8ec;
  color: #16a34a;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 44rpx;
  white-space: nowrap;
}

.verified-pill {
  gap: 8rpx;
  padding: 0 14rpx;
}

.verified-pill__icon {
  position: relative;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #16a34a;
}

.verified-pill__icon::before {
  position: absolute;
  top: 7rpx;
  left: 6rpx;
  width: 10rpx;
  height: 6rpx;
  border-bottom: 4rpx solid #ffffff;
  border-left: 4rpx solid #ffffff;
  transform: rotate(-45deg);
  content: "";
}

.rating-row {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  color: #111827;
  font-size: 26rpx;
  line-height: 36rpx;
}

.rating-star {
  margin-right: 8rpx;
  color: #ff7a1a;
  font-size: 30rpx;
  line-height: 30rpx;
}

.finished-text {
  margin-top: 12rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 34rpx;
}

.card-arrow,
.menu-arrow {
  color: #6b7280;
  font-size: 50rpx;
  font-weight: 300;
  line-height: 50rpx;
}

.status-card,
.range-card {
  display: flex;
  min-height: 112rpx;
  align-items: center;
  padding: 22rpx 28rpx;
}

.round-icon {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
  border-radius: 50%;
  background: #dcf5e2;
}

.round-icon--check::before {
  position: absolute;
  top: 19rpx;
  left: 18rpx;
  width: 26rpx;
  height: 14rpx;
  border-bottom: 7rpx solid #16a34a;
  border-left: 7rpx solid #16a34a;
  transform: rotate(-45deg);
  content: "";
}

.round-icon--pin::before {
  position: absolute;
  top: 14rpx;
  left: 18rpx;
  width: 28rpx;
  height: 36rpx;
  border-radius: 50% 50% 50% 0;
  background: #16a34a;
  transform: rotate(-45deg);
  content: "";
}

.round-icon--pin::after {
  position: absolute;
  top: 26rpx;
  left: 28rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #ffffff;
  content: "";
}

.status-main,
.range-main {
  min-width: 0;
  flex: 1;
  margin-left: 26rpx;
}

.card-title {
  overflow: hidden;
  color: #05070a;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 38rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-desc {
  overflow: hidden;
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 22rpx;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-card .card-desc {
  text-overflow: clip;
}

.status-action,
.range-action {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  margin-left: 18rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.status-action {
  gap: 10rpx;
}

.status-pill {
  position: relative;
  padding: 0 34rpx 0 18rpx;
  border: 1rpx solid #e5e7eb;
  background: #ffffff;
}

.status-pill::after {
  position: absolute;
  top: 17rpx;
  right: 15rpx;
  width: 10rpx;
  height: 10rpx;
  box-sizing: border-box;
  border-right: 3rpx solid #9ca3af;
  border-bottom: 3rpx solid #9ca3af;
  transform: rotate(45deg);
  content: "";
}

.status-switch {
  transform: scale(0.82);
  transform-origin: right center;
}

.stats-card {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  padding: 22rpx 0 18rpx;
}

.stat-item {
  position: relative;
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 112rpx;
  padding: 0 6rpx;
}

.stat-item:not(:last-child)::after {
  position: absolute;
  top: 6rpx;
  right: 0;
  width: 1rpx;
  height: 104rpx;
  background: #e5e7eb;
  content: "";
}

.stat-label {
  overflow: hidden;
  max-width: 150rpx;
  color: #6b7280;
  font-size: 22rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-value {
  overflow: visible;
  max-width: none;
  margin-top: 8rpx;
  color: #05070a;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 40rpx;
  white-space: nowrap;
}

.stat-icon,
.menu-icon {
  position: relative;
  width: 38rpx;
  height: 38rpx;
  margin-top: 12rpx;
  color: #16a34a;
}

.stat-icon--wallet,
.menu-icon--wallet {
  border-radius: 8rpx;
  background: currentColor;
}

.stat-icon--wallet::before,
.menu-icon--wallet::before {
  position: absolute;
  top: 8rpx;
  right: -5rpx;
  width: 18rpx;
  height: 17rpx;
  border-radius: 6rpx;
  background: currentColor;
  box-shadow: inset 0 0 0 3rpx rgba(255, 255, 255, 0.7);
  content: "";
}

.stat-icon--chat,
.menu-icon--chat {
  border-radius: 10rpx;
  background: currentColor;
}

.stat-icon--chat::after,
.menu-icon--chat::after {
  position: absolute;
  left: 8rpx;
  bottom: -7rpx;
  width: 14rpx;
  height: 14rpx;
  background: currentColor;
  transform: rotate(45deg);
  content: "";
}

.stat-icon--chat::before,
.menu-icon--chat::before {
  position: absolute;
  top: 16rpx;
  left: 8rpx;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 10rpx 0 0 #ffffff, 20rpx 0 0 #ffffff;
  content: "";
}

.stat-icon--bell,
.menu-icon--bell {
  color: #2f80ed;
}

.stat-icon--bell::before,
.menu-icon--bell::before {
  position: absolute;
  top: 4rpx;
  left: 6rpx;
  width: 26rpx;
  height: 28rpx;
  border-radius: 18rpx 18rpx 8rpx 8rpx;
  background: currentColor;
  content: "";
}

.stat-icon--bell::after,
.menu-icon--bell::after {
  position: absolute;
  bottom: 0;
  left: 13rpx;
  width: 13rpx;
  height: 8rpx;
  border-radius: 0 0 12rpx 12rpx;
  background: currentColor;
  content: "";
}

.stat-icon--star {
  color: #ffc400;
  font-size: 36rpx;
  line-height: 34rpx;
  text-align: center;
}

.menu-card {
  overflow: hidden;
  padding: 0 28rpx;
}

.menu-row {
  display: grid;
  min-height: 86rpx;
  grid-template-columns: 48rpx minmax(0, 1fr) 34rpx;
  column-gap: 24rpx;
  align-items: center;
  border-bottom: 1rpx solid #edf0f2;
}

.menu-row:last-child {
  border-bottom: 0;
}

.menu-title {
  overflow: hidden;
  color: #05070a;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 38rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-icon {
  width: 42rpx;
  height: 42rpx;
  margin-top: 0;
}

.menu-icon--green {
  color: #16a34a;
}

.menu-icon--blue {
  color: #2f80ed;
}

.menu-icon--orange {
  color: #ff7a1a;
}

.menu-icon--pin::before {
  position: absolute;
  top: 4rpx;
  left: 9rpx;
  width: 25rpx;
  height: 33rpx;
  border-radius: 50% 50% 50% 0;
  background: currentColor;
  transform: rotate(-45deg);
  content: "";
}

.menu-icon--pin::after {
  position: absolute;
  top: 15rpx;
  left: 18rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #ffffff;
  content: "";
}

.menu-icon--profile {
  border-radius: 8rpx;
  background: currentColor;
}

.menu-icon--profile::before {
  position: absolute;
  top: 7rpx;
  left: 15rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ffffff;
  content: "";
}

.menu-icon--profile::after {
  position: absolute;
  right: 10rpx;
  bottom: 8rpx;
  left: 10rpx;
  height: 9rpx;
  border-radius: 10rpx 10rpx 4rpx 4rpx;
  background: #ffffff;
  content: "";
}

.bottom-action {
  display: flex;
  width: 100%;
  height: 76rpx;
  margin: 22rpx 0 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #d1d5db;
  border-radius: 14rpx;
  background: #ffffff;
  color: #6b7280;
  font-size: 26rpx;
  line-height: 76rpx;
}

.bottom-action::after {
  border: 0;
}

.bottom-action--logout {
  margin-top: 16rpx;
}
