.worker-orders-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 88rpx 34rpx calc(210rpx + env(safe-area-inset-bottom));
  background: #f8faf9;
  color: #111827;
  font-family:
    -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial,
    sans-serif;
}

.worker-orders-header {
  margin-bottom: 30rpx;
}

.worker-orders-title {
  color: #05070a;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 54rpx;
}

.worker-orders-subtitle {
  margin-top: 14rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 34rpx;
}

.worker-order-tabs {
  display: block;
  width: 100%;
  margin: 16rpx 0 24rpx;
  white-space: nowrap;
}

.worker-order-tab {
  position: relative;
  display: inline-flex;
  width: 140rpx;
  height: 64rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 28rpx;
  background: #ffffff;
  color: #111827;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 64rpx;
}

.worker-order-tab:last-child {
  margin-right: 34rpx;
}

.worker-order-tab--active {
  border-color: #e5f5e8;
  background: #eaf8ed;
  color: #16a34a;
  font-weight: 700;
}

.worker-order-tab--active::after {
  position: absolute;
  bottom: -1rpx;
  left: 50%;
  width: 24rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #16a34a;
  transform: translateX(-50%);
  content: "";
}

.worker-order-filter-panel,
.worker-order-card {
  box-sizing: border-box;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(31, 41, 55, 0.07);
}

.worker-order-filter-panel {
  display: grid;
  min-height: 116rpx;
  grid-template-columns: minmax(0, 1fr) 1rpx minmax(0, 1fr);
  align-items: center;
  margin-bottom: 22rpx;
  padding: 22rpx 30rpx;
}

.filter-cell {
  position: relative;
  min-width: 0;
  padding-right: 34rpx;
}

.filter-cell::after {
  position: absolute;
  right: 2rpx;
  bottom: 10rpx;
  width: 0;
  height: 0;
  border-top: 10rpx solid #374151;
  border-right: 8rpx solid transparent;
  border-left: 8rpx solid transparent;
  content: "";
}

.filter-label {
  color: #6b7280;
  font-size: 22rpx;
  line-height: 30rpx;
}

.filter-value {
  overflow: hidden;
  margin-top: 8rpx;
  color: #111827;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-divider {
  width: 1rpx;
  height: 72rpx;
  background: #e5e7eb;
}

.worker-order-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.worker-order-card {
  display: grid;
  grid-template-columns: 116rpx minmax(0, 1fr) 108rpx;
  column-gap: 16rpx;
  align-items: start;
  overflow: hidden;
  padding: 26rpx 22rpx 22rpx;
}

.worker-order-visual-placeholder {
  width: 108rpx;
  height: 108rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #eefbea 0%, #eaf6ff 100%);
}

.worker-order-main {
  min-width: 0;
}

.worker-order-title-row {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.worker-order-name {
  overflow: hidden;
  max-width: 178rpx;
  color: #05070a;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.worker-order-tags {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.worker-order-tag {
  display: inline-flex;
  height: 36rpx;
  align-items: center;
  padding: 0 10rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 36rpx;
  white-space: nowrap;
}

.worker-order-tag--green {
  background: #e8f8ec;
  color: #16a34a;
}

.worker-order-tag--warm {
  background: #fff3e8;
  color: #ff7a1a;
}

.worker-order-info,
.worker-order-distance {
  overflow: hidden;
  margin-top: 12rpx;
  color: #374151;
  font-size: 24rpx;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.worker-order-distance {
  margin-top: 4rpx;
  color: #6b7280;
}

.worker-order-info::before {
  display: inline-block;
  width: 26rpx;
  margin-right: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
  text-align: center;
}

.worker-order-info--time::before {
  content: "◷";
}

.worker-order-info--address::before {
  content: "⌖";
}

.worker-order-info--contact::before {
  content: "♙";
}

.worker-order-side {
  display: flex;
  width: 108rpx;
  max-width: 108rpx;
  min-width: 0;
  flex-direction: column;
  align-items: stretch;
  justify-self: end;
  overflow: hidden;
}

.worker-order-status {
  height: 42rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 42rpx;
  text-align: center;
}

.worker-order-status--green {
  background: #e8f8ec;
  color: #16a34a;
}

.worker-order-status--blue {
  background: #eaf3ff;
  color: #2f80ed;
}

.worker-order-status--gray {
  background: #f3f4f6;
  color: #374151;
}

.worker-order-price {
  margin-top: 62rpx;
  color: #ff6a00;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 42rpx;
  text-align: right;
  white-space: nowrap;
}

.worker-order-price-label {
  margin-top: 4rpx;
  color: #6b7280;
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: right;
}

.worker-order-actions {
  display: flex;
  grid-column: 2 / 4;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}

.worker-order-action {
  display: flex;
  width: 156rpx;
  height: 56rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 56rpx;
  overflow: hidden;
}

.worker-order-action--secondary {
  border: 1rpx solid #e5e7eb;
  background: #ffffff;
  color: #111827;
}

.worker-order-action--primary {
  border: 1rpx solid #16a34a;
  background: #16a34a;
  color: #ffffff;
}

.worker-order-action::after {
  border: 0;
}
