@import "../../../styles/worker-subpage.wxss";

.income-page {
  min-height: 100vh;
  box-sizing: border-box;
  overflow-x: hidden;
  padding: calc(116rpx + env(safe-area-inset-top)) 36rpx
    calc(172rpx + env(safe-area-inset-bottom));
  background: #f8faf9;
  color: #111827;
  font-family:
    -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial,
    sans-serif;
}

.income-header {
  margin-bottom: 30rpx;
}

.income-title {
  color: #05070a;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 54rpx;
}

.income-subtitle {
  margin-top: 14rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 34rpx;
}

.income-hero-card,
.income-stat-card,
.income-boundary-card,
.earning-card {
  box-sizing: border-box;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(31, 41, 55, 0.07);
}

.income-hero-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28rpx;
  padding: 32rpx;
}

.summary-label {
  color: #6b7280;
  font-size: 24rpx;
  line-height: 34rpx;
}

.summary-value {
  margin-top: 10rpx;
  color: #ff6a00;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 60rpx;
}

.summary-count-wrap {
  flex: 0 0 auto;
  text-align: right;
}

.summary-count {
  margin-top: 10rpx;
  color: #16a34a;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 54rpx;
}

.income-stat-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 18rpx;
}

.income-stat-card {
  min-height: 118rpx;
  padding: 24rpx;
}

.status-amount {
  margin-top: 10rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.income-boundary-card {
  margin-top: 20rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid #ffe1c2;
  background: #fff9f3;
  box-shadow: none;
}

.boundary-title {
  color: #ff6a00;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 38rpx;
}

.boundary-desc {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 36rpx;
}

.section-head {
  margin: 32rpx 0 18rpx;
}

.section-title {
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.section-desc {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 34rpx;
}

.income-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.earning-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 22rpx;
  padding: 26rpx;
}

.earning-main {
  min-width: 0;
  flex: 1;
}

.earning-title-row {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12rpx;
}

.earning-name {
  overflow: hidden;
  min-width: 0;
  color: #111827;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.earning-status {
  display: inline-flex;
  height: 38rpx;
  flex: 0 0 auto;
  align-items: center;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #eaf8e8;
  color: #16a34a;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 38rpx;
  white-space: nowrap;
}

.earning-meta {
  overflow: hidden;
  margin-top: 9rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.earning-side {
  width: 150rpx;
  flex: 0 0 150rpx;
  text-align: right;
}

.earning-price {
  color: #ff6a00;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 42rpx;
  white-space: nowrap;
}

.earning-label {
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 22rpx;
  line-height: 30rpx;
}
