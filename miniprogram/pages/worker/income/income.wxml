<view class="page-shell">
  <view class="page-header">
    <view class="page-title">{{ title }}</view>
    <view class="page-subtitle">基于模拟支付与订单完成生成，提现暂未开放</view>
  </view>

  <loading-view wx:if="{{ loading }}" text="正在加载收入"></loading-view>

  <block wx:else>
    <view class="income-summary panel">
      <view>
        <view class="summary-label">累计收入</view>
        <view class="summary-value">{{ totalAmountText }}</view>
      </view>
      <view>
        <view class="summary-label">收益笔数</view>
        <view class="summary-count">{{ totalCount }}</view>
      </view>
    </view>

    <view class="status-grid">
      <view class="status-item panel">
        <view class="summary-label">冻结中</view>
        <view class="status-amount">{{ frozenAmountText }}</view>
      </view>
      <view class="status-item panel">
        <view class="summary-label">可结算</view>
        <view class="status-amount">{{ settleableAmountText }}</view>
      </view>
      <view class="status-item panel">
        <view class="summary-label">已结算</view>
        <view class="status-amount">{{ settledAmountText }}</view>
      </view>
      <view class="status-item panel">
        <view class="summary-label">已冲回</view>
        <view class="status-amount">{{ reversedAmountText }}</view>
      </view>
    </view>

    <view wx:if="{{ earnings.length }}" class="income-list">
      <view wx:for="{{ earnings }}" wx:key="_id" class="income-row panel">
        <view>
          <view class="income-name">{{ item.service_name }}</view>
          <view class="income-time">{{ item.appointment_time }}</view>
          <view class="income-time"
            >状态：{{ item.statusText }}　平台服务费：{{ item.commissionText
            }}</view
          >
        </view>
        <view class="income-price">{{ item.workerEarningText }}</view>
      </view>
    </view>

    <empty-state
      wx:else
      title="暂无收入"
      description="订单完成并评价后会计入收入"
    ></empty-state>
  </block>
</view>
