<view class="page-shell">
  <view class="page-header">
    <view class="page-title">{{ title }}</view>
    <view class="page-subtitle">阶段五先展示已接订单，开始服务与完成服务在下一阶段接入</view>
  </view>

  <loading-view wx:if="{{ loading }}" text="正在加载订单"></loading-view>

  <block wx:elif="{{ order }}">
    <view class="detail-card panel">
      <view class="detail-card__top">
        <view>
          <view class="order-name">{{ order.service_name }}</view>
          <view class="order-no">订单号：{{ order.order_no }}</view>
        </view>
        <view class="order-price">{{ priceText }}</view>
      </view>
      <view class="status-grid">
        <view>
          <text class="meta-label">订单状态</text>
          <text class="meta-value">{{ statusText }}</text>
        </view>
        <view>
          <text class="meta-label">支付状态</text>
          <text class="meta-value">{{ payStatusText }}</text>
        </view>
      </view>
    </view>

    <view class="info-panel panel">
      <view class="info-row">
        <text>预约时间</text>
        <text>{{ order.appointment_time }}</text>
      </view>
      <view class="info-row">
        <text>联系人</text>
        <text>{{ order.contact_name }} {{ order.contact_phone }}</text>
      </view>
      <view class="info-row info-row--address">
        <text>服务地址</text>
        <text>{{ order.full_address }}</text>
      </view>
      <view wx:if="{{ order.remark }}" class="info-row info-row--address">
        <text>备注</text>
        <text>{{ order.remark }}</text>
      </view>
    </view>
  </block>

  <empty-state
    wx:else
    title="订单不存在"
    description="请返回师傅订单列表重新查看"
  ></empty-state>
</view>
