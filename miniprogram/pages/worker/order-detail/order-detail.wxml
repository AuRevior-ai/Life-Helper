<view class="page-shell">
  <view class="page-header">
    <view class="page-title">{{ title }}</view>
    <view class="page-subtitle">按服务进度更新订单，完成后等待用户评价</view>
  </view>

  <loading-view wx:if="{{ loading }}" text="正在加载订单"></loading-view>

  <block wx:elif="{{ order }}">
    <view class="detail-card panel">
      <view class="detail-card__top">
        <view>
          <view class="order-name">{{ order.service_name }}</view>
          <view class="order-no">订单号：{{ order.order_no }}</view>
        </view>
        <view class="order-price">{{ priceText }}</view>
      </view>
      <view class="status-grid">
        <view>
          <text class="meta-label">订单状态</text>
          <text class="meta-value">{{ statusText }}</text>
        </view>
        <view>
          <text class="meta-label">支付状态</text>
          <text class="meta-value">{{ payStatusText }}</text>
        </view>
      </view>
    </view>

    <view class="info-panel panel">
      <view class="info-row">
        <text>预约时间</text>
        <text>{{ order.appointment_time }}</text>
      </view>
      <view class="info-row">
        <text>联系人</text>
        <text>{{ order.contact_name }} {{ order.contact_phone }}</text>
      </view>
      <view class="info-row info-row--address">
        <text>服务地址</text>
        <text>{{ order.full_address }}</text>
      </view>
      <view wx:if="{{ order.remark }}" class="info-row info-row--address">
        <text>备注</text>
        <text>{{ order.remark }}</text>
      </view>
      <view wx:if="{{ order.finish_remark }}" class="info-row info-row--address">
        <text>完工说明</text>
        <text>{{ order.finish_remark }}</text>
      </view>
      <view wx:if="{{ order.finish_images && order.finish_images.length }}" class="finish-images">
        <image wx:for="{{ order.finish_images }}" wx:key="*this" class="finish-image" src="{{ item }}" mode="aspectFill"></image>
      </view>
    </view>

    <button
      wx:if="{{ canStart }}"
      class="primary-button"
      loading="{{ submitting }}"
      disabled="{{ submitting }}"
      bindtap="startService"
    >开始服务</button>

    <view wx:if="{{ canFinish }}" class="panel finish-panel">
      <view class="form-item">
        <text class="form-label">完工说明</text>
        <textarea
          class="form-textarea"
          value="{{ finishRemark }}"
          placeholder="请填写本次服务完成情况"
          bindinput="handleFinishRemarkInput"
        ></textarea>
      </view>
      <view class="finish-upload-row">
        <button class="ghost-button" bindtap="chooseFinishImages">选择完工图片</button>
        <text>{{ finishImages.length }}/3</text>
      </view>
      <view wx:if="{{ finishImages.length }}" class="finish-images">
        <view wx:for="{{ finishImages }}" wx:key="*this" class="finish-image-wrap">
          <image class="finish-image" src="{{ item }}" mode="aspectFill"></image>
          <button class="remove-image" data-index="{{ index }}" bindtap="removeFinishImage">删除</button>
        </view>
      </view>
      <button
        class="primary-button"
        loading="{{ submitting }}"
        disabled="{{ submitting }}"
        bindtap="finishService"
      >完成服务</button>
    </view>
  </block>

  <empty-state
    wx:else
    title="订单不存在"
    description="请返回师傅订单列表重新查看"
  ></empty-state>
</view>
