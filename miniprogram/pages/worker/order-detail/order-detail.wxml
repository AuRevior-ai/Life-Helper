<view class="worker-detail-page">
  <view class="detail-header">
    <view class="detail-title">师傅订单详情</view>
    <view class="detail-subtitle">服务进度由订单状态决定，页面仅展示和触发已有操作</view>
  </view>

  <loading-view
    wx:if="{{ loading && !order }}"
    text="正在加载订单"
  ></loading-view>

  <block wx:elif="{{ order }}">
    <view class="detail-status-card">
      <view class="status-card-main">
        <view class="section-kicker">当前状态</view>
        <view class="status-title-row">
          <status-tag
            text="{{ order.statusView.text }}"
            tone="{{ order.statusView.tone }}"
          ></status-tag>
          <status-tag
            text="{{ order.payStatusView.text }}"
            tone="{{ order.payStatusView.tone }}"
          ></status-tag>
        </view>
        <view class="status-next">下一步：{{ order.nextStepText }}</view>
      </view>
      <view class="status-time">
        <view class="status-time-label">时间信息</view>
        <view class="status-time-value">{{ order.timeText }}</view>
      </view>
    </view>

    <view class="detail-service-card detail-card">
      <view class="card-head">
        <view>
          <view class="section-kicker">服务信息</view>
          <view class="card-title">{{ order.serviceName }}</view>
        </view>
        <view class="amount-pill">{{ priceText }}</view>
      </view>
      <view class="detail-row">
        <text>服务分类</text>
        <text>{{ order.categoryText }}</text>
      </view>
      <view class="detail-row">
        <text>服务时间</text>
        <text>{{ order.appointmentText }}</text>
      </view>
      <view class="detail-row">
        <text>订单编号</text>
        <text>{{ order.orderNoText }}</text>
      </view>
    </view>

    <view class="detail-customer-card detail-card">
      <view class="card-title">用户与地址</view>
      <view class="detail-row">
        <text>联系人</text>
        <text>{{ order.contactName }}</text>
      </view>
      <view class="detail-row">
        <text>联系电话</text>
        <text>{{ order.maskedPhone }}</text>
      </view>
      <view class="detail-row detail-row--top">
        <text>服务地址</text>
        <text>{{ order.addressText }}</text>
      </view>
      <view class="detail-row">
        <text>距离信息</text>
        <text>{{ order.distanceText }}</text>
      </view>
      <view wx:if="{{ order.remark }}" class="detail-note">
        <view class="detail-note-label">用户备注</view>
        <view class="detail-note-content">{{ order.remark }}</view>
      </view>
    </view>

    <view class="detail-amount-card detail-card">
      <view class="card-title">金额信息</view>
      <view
        wx:for="{{ order.amountRows }}"
        wx:key="label"
        class="detail-row"
      >
        <text>{{ item.label }}</text>
        <text class="{{ item.highlight ? 'amount-value' : '' }}">{{ item.value }}</text>
      </view>
      <view class="amount-hint">仅展示后端返回金额，不改变收益计算和结算状态</view>
    </view>

    <view wx:if="{{ review }}" class="detail-card review-card">
      <view class="card-title">用户评价</view>
      <view class="detail-row">
        <text>评分</text>
        <text>{{ review.rating }} 分</text>
      </view>
      <view class="detail-note">
        <view class="detail-note-label">评价内容</view>
        <view class="detail-note-content">{{ review.content || '暂无文字评价' }}</view>
      </view>
      <view class="detail-note">
        <view class="detail-note-label">追评内容</view>
        <view class="detail-note-content">{{ review.followup_content || '暂无追评' }}</view>
      </view>
      <view class="detail-note">
        <view class="detail-note-label">师傅回复</view>
        <view class="detail-note-content">{{ review.worker_reply_content || '暂无回复' }}</view>
      </view>
    </view>

    <view class="detail-action-card detail-card">
      <view class="card-title">操作区</view>
      <view class="action-hint">
        操作按当前已有订单状态展示，不新增状态流转。
      </view>

      <button
        wx:if="{{ canStart }}"
        class="detail-primary-button"
        loading="{{ submitting }}"
        disabled="{{ submitting }}"
        bindtap="startService"
      >
        开始服务
      </button>

      <view wx:if="{{ canFinish }}" class="finish-panel">
        <view class="form-item finish-form-item">
          <text class="form-label">完工说明</text>
          <textarea
            class="form-textarea"
            value="{{ finishRemark }}"
            placeholder="请填写本次服务完成情况"
            bindinput="handleFinishRemarkInput"
          ></textarea>
        </view>
        <view class="finish-upload-row">
          <button class="detail-secondary-button" bindtap="chooseFinishImages">
            选择完工图片
          </button>
          <text>{{ finishImages.length }}/3</text>
        </view>
        <view wx:if="{{ finishImages.length }}" class="finish-images">
          <view
            wx:for="{{ finishImages }}"
            wx:key="*this"
            class="finish-image-wrap"
          >
            <image
              class="finish-image"
              src="{{ item }}"
              mode="aspectFill"
            ></image>
            <button
              class="remove-image"
              data-index="{{ index }}"
              bindtap="removeFinishImage"
            >
              删除
            </button>
          </view>
        </view>
        <button
          class="detail-primary-button"
          loading="{{ submitting }}"
          disabled="{{ submitting }}"
          bindtap="finishService"
        >
          完成服务
        </button>
      </view>

      <view wx:if="{{ !canStart && !canFinish }}" class="action-empty">
        当前订单暂无可操作项
      </view>
    </view>
  </block>

  <view wx:else class="detail-empty">
    <empty-state
      title="{{ errorText || '订单不存在' }}"
      description="请返回师傅订单列表重新查看"
    ></empty-state>
  </view>
</view>
