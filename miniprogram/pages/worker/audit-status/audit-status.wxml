<view class="page-shell">
  <view class="page-header">
    <view class="page-title">{{ title }}</view>
    <view class="page-subtitle">选择个人师傅端后先确认审核状态</view>
  </view>

  <loading-view wx:if="{{ loading }}" text="正在加载审核状态"></loading-view>

  <block wx:else>
    <view class="status-panel panel">
      <view class="status-label">当前状态</view>
      <view class="status-text">{{ auditStatusText }}</view>
      <view wx:if="{{ worker && worker.reject_reason }}" class="status-reason">
        {{ worker.reject_reason }}
      </view>
      <view wx:if="{{ isApproved }}" class="status-tip status-tip--approved">
        {{ approvedTip }}
      </view>
      <view wx:if="{{ isRejected }}" class="status-tip status-tip--rejected">
        未通过审核，请联系管理员
      </view>
    </view>

    <view wx:if="{{ worker }}" class="worker-info panel">
      <view class="info-row">
        <text>姓名</text>
        <text>{{ worker.name }}</text>
      </view>
      <view class="info-row">
        <text>服务分类</text>
        <text>{{ worker.service_category }}</text>
      </view>
      <view class="info-row">
        <text>服务区域</text>
        <text>{{ worker.service_area }}</text>
      </view>
    </view>

    <button
      wx:if="{{ isNotApplied }}"
      class="primary-button"
      bindtap="goApply"
    >
      重新提交申请
    </button>
  </block>
</view>
