<view class="worker-apply-page worker-subpage">
  <view class="apply-header worker-subpage-header">
    <view class="apply-title worker-subpage-title">{{ title }}</view>
    <view class="apply-subtitle worker-subpage-subtitle">提交基础资料和服务范围，管理员人工审核通过后即可接单</view>
  </view>

  <view class="apply-boundary-card">
    <view class="boundary-title">人工审核</view>
    <view class="boundary-desc">
      当前仅作展示和资料留档，不接入真实身份证认证、营业执照认证、OCR、保险核验或真实风控。
    </view>
  </view>

  <view class="apply-form-card">
    <view class="section-title">基础资料</view>
    <view class="form-item">
      <text class="form-label">姓名</text>
      <input
        class="form-input"
        value="{{ form.name }}"
        data-field="name"
        placeholder="请输入姓名"
        bindinput="handleInput"
      />
    </view>

    <view class="form-item">
      <text class="form-label">手机号</text>
      <input
        class="form-input"
        value="{{ form.phone }}"
        data-field="phone"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        bindinput="handleInput"
      />
    </view>
  </view>

  <view class="apply-form-card">
    <view class="section-title">服务范围</view>
    <view class="form-item">
      <text class="form-label">服务分类</text>
      <input
        class="form-input"
        value="{{ form.service_category }}"
        data-field="service_category"
        placeholder="例如：维修服务"
        bindinput="handleInput"
      />
    </view>

    <view class="form-item">
      <text class="form-label">服务区域</text>
      <picker mode="selector" range="{{ areaNames }}" bindchange="onAreaChange">
        <view class="form-input form-picker"
          >{{ form.service_area || '请选择服务小区' }}</view
        >
      </picker>
    </view>

    <view class="form-item">
      <text class="form-label">个人简介</text>
      <textarea
        class="form-textarea"
        value="{{ form.intro }}"
        data-field="intro"
        placeholder="可填写经验年限、擅长项目"
        bindinput="handleInput"
      ></textarea>
    </view>
  </view>

  <button
    class="apply-primary-button"
    loading="{{ submitting }}"
    disabled="{{ submitting }}"
    bindtap="handleSubmit"
  >
    提交审核
  </button>

  <button class="apply-secondary-button" bindtap="goAuditStatus">
    查看审核状态
  </button>
</view>
