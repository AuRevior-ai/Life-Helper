.hall-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 88rpx 34rpx calc(210rpx + env(safe-area-inset-bottom));
  background: #f8faf9;
  color: #111827;
  font-family:
    -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial,
    sans-serif;
}

.hall-header {
  margin-bottom: 30rpx;
}

.hall-title {
  color: #05070a;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 54rpx;
}

.hall-subtitle {
  margin-top: 14rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 34rpx;
}

.hall-status-card,
.hall-order-card {
  box-sizing: border-box;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(31, 41, 55, 0.07);
}

.hall-status-card {
  display: flex;
  min-height: 150rpx;
  align-items: center;
  padding: 28rpx 28rpx;
}

.status-icon {
  position: relative;
  width: 78rpx;
  height: 78rpx;
  flex: 0 0 78rpx;
  border-radius: 50%;
  background: #dcf5e2;
}

.status-icon--check::before {
  position: absolute;
  top: 23rpx;
  left: 21rpx;
  width: 34rpx;
  height: 18rpx;
  border-bottom: 8rpx solid #16a34a;
  border-left: 8rpx solid #16a34a;
  transform: rotate(-45deg);
  content: "";
}

.status-content {
  min-width: 0;
  flex: 1;
  margin-left: 30rpx;
}

.status-title-row {
  display: flex;
  min-width: 0;
  align-items: center;
  flex-wrap: wrap;
}

.status-title,
.status-online {
  font-size: 30rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.status-title {
  color: #05070a;
}

.status-online {
  color: #16a34a;
}

.status-meta {
  margin-top: 12rpx;
  color: #6b7280;
  font-size: 23rpx;
  line-height: 32rpx;
}

.status-meta text {
  color: #16a34a;
  font-weight: 800;
}

.status-switch {
  flex: 0 0 auto;
  margin-left: 18rpx;
  transform: scale(0.82);
  transform-origin: right center;
}

.hall-filter-bar {
  display: block;
  width: 100%;
  margin: 30rpx 0 22rpx;
  box-sizing: border-box;
  white-space: nowrap;
}

.filter-pill {
  position: relative;
  display: inline-flex;
  height: 60rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  min-width: 152rpx;
  margin-right: 16rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 999rpx;
  background: #ffffff;
  color: #111827;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 60rpx;
}

.filter-pill:last-child {
  min-width: 190rpx;
  margin-right: 34rpx;
}

.filter-pill--active {
  border-color: #dbf3df;
  background: #eaf8ed;
  color: #16a34a;
}

.filter-pill text {
  width: 0;
  height: 0;
  margin-left: 12rpx;
  border-top: 8rpx solid currentColor;
  border-right: 8rpx solid transparent;
  border-left: 8rpx solid transparent;
}

.filter-pill--location::before,
.filter-pill--pin::before,
.filter-pill--time::before {
  position: relative;
  display: inline-block;
  flex: 0 0 auto;
  margin-right: 12rpx;
  content: "";
}

.filter-pill--location::before,
.filter-pill--pin::before {
  width: 18rpx;
  height: 24rpx;
  border: 4rpx solid currentColor;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
}

.filter-pill--time::before {
  width: 24rpx;
  height: 24rpx;
  box-sizing: border-box;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.hall-order-card {
  display: grid;
  min-height: 218rpx;
  grid-template-columns: 116rpx minmax(0, 1fr) 108rpx;
  column-gap: 16rpx;
  align-items: center;
  margin-top: 22rpx;
  overflow: hidden;
  padding: 26rpx 22rpx;
}

.order-visual-placeholder {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #eefbea 0%, #eaf6ff 100%);
}

.order-main {
  min-width: 0;
}

.order-title-row {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}

.order-name {
  overflow: hidden;
  max-width: 190rpx;
  color: #05070a;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag-group {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.order-tag {
  display: inline-flex;
  height: 38rpx;
  align-items: center;
  padding: 0 12rpx;
  border-radius: 8rpx;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 38rpx;
  white-space: nowrap;
}

.order-tag--green {
  background: #e8f8ec;
  color: #16a34a;
}

.order-tag--warm {
  background: #fff3e8;
  color: #ff7a1a;
}

.order-info,
.order-distance {
  overflow: hidden;
  margin-top: 12rpx;
  color: #374151;
  font-size: 24rpx;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-distance {
  margin-top: 4rpx;
  color: #6b7280;
}

.order-info::before {
  display: inline-block;
  width: 26rpx;
  margin-right: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
  text-align: center;
}

.order-info--time::before {
  content: "◷";
}

.order-info--address::before {
  content: "⌖";
}

.order-info--contact::before {
  content: "♙";
}

.order-side {
  display: flex;
  width: 108rpx;
  max-width: 108rpx;
  min-width: 0;
  flex-direction: column;
  align-items: stretch;
  justify-self: end;
  overflow: hidden;
}

.order-price {
  color: #ff6a00;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 42rpx;
  text-align: right;
  white-space: nowrap;
}

.order-income-label {
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: right;
}

.accept-button {
  display: flex;
  width: 108rpx;
  max-width: 108rpx;
  min-width: 0;
  height: 60rpx;
  box-sizing: border-box;
  margin: 30rpx 0 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 16rpx;
  background: #16a34a;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 60rpx;
  overflow: hidden;
}

.accept-button::after {
  border: 0;
}
