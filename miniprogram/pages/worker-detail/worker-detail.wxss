@import "../../styles/ui-kit.wxss";

.worker-profile {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 30rpx 28rpx;
}

.worker-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  color: #16a34a;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 104rpx;
  text-align: center;
}

.worker-info {
  flex: 1;
}

.worker-name {
  color: #111827;
  font-size: 34rpx;
  font-weight: 800;
}

.worker-meta,
.intro-text,
.review-content {
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 25rpx;
  line-height: 1.5;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 22rpx;
  text-align: center;
}

.stat-value,
.stat-label {
  display: block;
}

.stat-value {
  color: #ff6a00;
  font-size: 40rpx;
  font-weight: 800;
}

.stat-label {
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 23rpx;
}

.intro-panel,
.review-list {
  margin-top: 22rpx;
}

.review-rating {
  color: #111827;
  font-size: 28rpx;
  font-weight: 800;
}

.review-section-head {
  margin-top: 32rpx;
}

.review-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
