<view class="worker-detail-page ui-page ui-page--dense">
  <view class="ui-header">
    <view class="ui-title">{{ title }}</view>
    <view class="ui-subtitle">查看服务人员资料和用户评价</view>
  </view>

  <loading-view wx:if="{{ loading }}" text="正在加载师傅详情"></loading-view>

  <block wx:elif="{{ worker }}">
    <view class="worker-profile ui-feature-card">
      <view class="worker-avatar ui-avatar-placeholder"
        >{{ worker.name ? worker.name.slice(0, 1) : '师' }}</view
      >
      <view class="worker-info">
        <view class="worker-name">{{ worker.name }}</view>
        <view class="worker-meta"
          >{{ worker.service_category }} · {{ worker.service_area }}</view
        >
        <view class="worker-meta"
          >接单状态：{{ worker.online_status || 'available' }}</view
        >
        <view class="worker-meta">审核状态：{{ worker.audit_status }}</view>
      </view>
    </view>

    <view class="stats-grid ui-card">
      <view>
        <text class="stat-value">{{ completedCount }}</text>
        <text class="stat-label">完成订单</text>
      </view>
      <view>
        <text class="stat-value">{{ averageRating }}</text>
        <text class="stat-label">平均评分</text>
      </view>
    </view>

    <view wx:if="{{ worker.intro }}" class="ui-card intro-panel">
      <view class="ui-section-title section-title">个人简介</view>
      <view class="intro-text">{{ worker.intro }}</view>
    </view>

    <view class="ui-section-head review-section-head">
      <text class="ui-section-title">用户评价</text>
    </view>
    <view wx:if="{{ reviews.length }}" class="review-list">
      <view wx:for="{{ reviews }}" wx:key="_id" class="ui-card ui-card--compact review-item">
        <view class="review-rating">{{ item.rating }} 分</view>
        <view class="review-content"
          >{{ item.content || '用户未填写评价内容' }}</view
        >
      </view>
    </view>
    <empty-state
      wx:else
      title="暂无评价"
      description="完成服务并被评价后会展示在这里"
    ></empty-state>
  </block>

  <empty-state
    wx:else
    title="师傅不存在"
    description="请返回订单详情重新查看"
  ></empty-state>
</view>
