@import "../../../styles/ui-kit.wxss";

.detail-panel {
  margin-top: 8rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf0f2;
  color: #374151;
  font-size: 26rpx;
}

.detail-row:last-child {
  border-bottom: 0;
}

.detail-row text:first-child {
  flex: 0 0 150rpx;
  color: #6b7280;
}

.detail-row text:last-child {
  flex: 1;
  text-align: right;
}
