<view class="merchant-page merchant-deposit-page">
  <view class="merchant-header merchant-subpage-header">
    <button class="merchant-back-button" bindtap="goBack">返回</button>
    <view class="merchant-title">保证金</view>
    <view class="merchant-subtitle">mock 保证金流程，不产生真实扣款、退款或冻结</view>
  </view>

  <view class="merchant-section-card merchant-boundary-card">
    <view class="merchant-section-title">怎样算通过？</view>
    <view class="merchant-section-note">
      模拟保证金只用于流程验证，不会产生真实扣款、退款或冻结；状态显示为 MOCK_PAID（已模拟缴纳）才算完成保证金流程。冻结保证金是管理员在风险复核时使用的管控动作，不是正常缴费步骤。
    </view>
  </view>

  <view wx:if="{{loading}}" class="merchant-loading">正在加载保证金状态</view>
  <view wx:elif="{{errorText}}" class="merchant-error">{{errorText}}</view>

  <block wx:else>
    <view class="merchant-section-card merchant-deposit-card">
      <view class="merchant-section-head">
        <view>
          <view class="merchant-section-title">当前保证金</view>
          <view class="merchant-section-note">状态和金额以后端返回为准</view>
        </view>
        <view class="merchant-pill">{{depositView.statusText}}</view>
      </view>
      <view class="merchant-detail-row">
        <text class="merchant-detail-label">应缴金额</text>
        <text class="merchant-detail-value">{{depositView.requiredAmountText}}</text>
      </view>
      <view class="merchant-detail-row">
        <text class="merchant-detail-label">已模拟缴纳</text>
        <text class="merchant-detail-value">{{depositView.paidAmountText}}</text>
      </view>
      <view class="merchant-section-note merchant-helper-text">{{depositView.helperText}}</view>
      <view wx:if="{{deposit.frozen_reason}}" class="merchant-section-note merchant-helper-text">
        冻结原因：{{deposit.frozen_reason}}
      </view>
      <view wx:if="{{deposit.refund_reject_reason}}" class="merchant-section-note merchant-helper-text">
        退还驳回：{{deposit.refund_reject_reason}}
      </view>
    </view>

    <view class="merchant-section-card merchant-action-card">
      <view class="merchant-section-title">保证金操作</view>
      <view class="merchant-section-note">
        模拟缴纳与申请模拟退还仍使用既有 qualification service，不接入真实支付或真实退款。
      </view>
      <button
        wx:if="{{canMockPay}}"
        class="merchant-action-button merchant-action-wide"
        loading="{{actionLoading === 'mockPay'}}"
        disabled="{{!!actionLoading}}"
        bindtap="mockPay"
      >
        模拟缴纳保证金
      </button>
      <button
        wx:if="{{canApplyRefund}}"
        class="merchant-outline-button merchant-action-wide"
        loading="{{actionLoading === 'refund'}}"
        disabled="{{!!actionLoading}}"
        bindtap="applyRefund"
      >
        申请模拟退还
      </button>
    </view>
  </block>
</view>
