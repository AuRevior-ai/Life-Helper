@import "/styles/merchant-theme.wxss";

.merchant-deposit-page {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.merchant-subpage-header {
  position: relative;
}

.merchant-back-button {
  display: inline-flex;
  min-width: 104rpx;
  height: 52rpx;
  margin: 0 0 22rpx;
  padding: 0 22rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #d8e4df;
  border-radius: 999rpx;
  background: #ffffff;
  color: #1f7a68;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 52rpx;
}

.merchant-back-button::after {
  border: 0;
}

.merchant-boundary-card {
  border: 1rpx solid #f1dfb6;
  background: #fffaf0;
}

.merchant-detail-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #edf1ee;
}

.merchant-detail-row:last-of-type {
  border-bottom: 0;
}

.merchant-detail-label {
  color: #63716b;
  font-size: 24rpx;
  line-height: 34rpx;
}

.merchant-detail-value {
  color: #17231f;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 38rpx;
  text-align: right;
}

.merchant-helper-text {
  margin-top: 18rpx;
}

.merchant-action-wide {
  width: 100%;
  min-width: 0;
  margin-top: 22rpx;
  border-radius: 999rpx;
}
