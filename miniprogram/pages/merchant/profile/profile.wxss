@import "/styles/merchant-theme.wxss";

.merchant-profile-hero {
  display: flex;
  min-height: 230rpx;
  align-items: center;
  gap: 28rpx;
  padding: 34rpx;
  background: linear-gradient(135deg, #ffffff 0%, #e7f5ef 100%);
}

.merchant-profile-mark {
  display: flex;
  width: 118rpx;
  height: 118rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 34rpx;
  background: #1f7a68;
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 800;
}

.merchant-profile-main {
  min-width: 0;
}

.merchant-profile-name {
  overflow: hidden;
  color: #17231f;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 52rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.merchant-profile-main .merchant-pill {
  margin-top: 14rpx;
}

.merchant-profile-line {
  overflow: hidden;
  margin-top: 14rpx;
  color: #63716b;
  font-size: 25rpx;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.merchant-boundary-tags {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 22rpx;
}

.merchant-boundary-tags .merchant-pill {
  justify-content: center;
  overflow: hidden;
  padding: 0 12rpx;
  text-overflow: ellipsis;
}

.merchant-boundary-desc {
  margin-top: 20rpx;
  color: #63716b;
  font-size: 25rpx;
  line-height: 38rpx;
}
