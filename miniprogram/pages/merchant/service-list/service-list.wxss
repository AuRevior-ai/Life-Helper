@import "/styles/merchant-theme.wxss";

.merchant-service-list {
  margin-top: 0;
}

.merchant-service-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.merchant-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.merchant-card-title {
  flex: 1;
  overflow: hidden;
  color: #17231f;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 42rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.merchant-card-line {
  overflow: hidden;
  margin-top: 14rpx;
  color: #63716b;
  font-size: 25rpx;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
