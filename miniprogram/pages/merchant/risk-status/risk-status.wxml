<view class="page-shell onboarding-page">
  <view class="page-header">
    <view class="page-title">准入进度</view>
    <view class="page-subtitle">查看资质、保证金和风控复核后的经营权限</view>
  </view>

  <view class="status-hero panel {{statusView.tone}}">
    <view class="status-label">当前状态</view>
    <view class="status-title">{{statusView.statusText}}</view>
    <view class="status-summary">{{statusView.summary}}</view>
  </view>

  <view class="panel status-grid">
    <view class="status-row">
      <text class="row-label">经营权限</text>
      <text class="row-value">{{statusView.permissionText}}</text>
    </view>
    <view class="status-row">
      <text class="row-label">风险等级</text>
      <text class="row-value">{{statusView.riskText}}</text>
    </view>
    <view class="status-row">
      <text class="row-label">下一步</text>
      <text class="row-value">{{statusView.nextActionText}}</text>
    </view>
  </view>
</view>
