@import "/styles/merchant-theme.wxss";

.merchant-risk-page {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.merchant-subpage-header {
  position: relative;
}

.merchant-back-button {
  display: inline-flex;
  min-width: 104rpx;
  height: 52rpx;
  margin: 0 0 22rpx;
  padding: 0 22rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #d8e4df;
  border-radius: 999rpx;
  background: #ffffff;
  color: #1f7a68;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 52rpx;
}

.merchant-back-button::after {
  border: 0;
}

.merchant-boundary-card {
  border: 1rpx solid #f1dfb6;
  background: #fffaf0;
}

.merchant-risk-hero {
  border-left: 8rpx solid #1f7a68;
}

.merchant-risk-hero.warn {
  border-left-color: #b65230;
}

.merchant-risk-title {
  margin: 14rpx 0 12rpx;
  color: #17231f;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 52rpx;
}

.merchant-detail-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #edf1ee;
}

.merchant-detail-row:last-child {
  border-bottom: 0;
}

.merchant-detail-row--stack {
  display: block;
}

.merchant-detail-label {
  color: #63716b;
  font-size: 24rpx;
  line-height: 34rpx;
}

.merchant-detail-value {
  flex: 1;
  color: #17231f;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 40rpx;
  text-align: right;
}

.merchant-detail-row--stack .merchant-detail-value {
  display: block;
  margin-top: 10rpx;
  text-align: left;
}
