@import "/styles/merchant-theme.wxss";

.merchant-qualification-page {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.merchant-subpage-header {
  position: relative;
}

.merchant-back-button {
  display: inline-flex;
  min-width: 104rpx;
  height: 52rpx;
  margin: 0 0 22rpx;
  padding: 0 22rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #d8e4df;
  border-radius: 999rpx;
  background: #ffffff;
  color: #1f7a68;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 52rpx;
}

.merchant-back-button::after {
  border: 0;
}

.merchant-boundary-card {
  border: 1rpx solid #f1dfb6;
  background: #fffaf0;
}

.merchant-reject-note {
  margin-top: 24rpx;
  color: #b65230;
}

.merchant-form-card {
  padding-bottom: 12rpx;
}

.merchant-form-item {
  padding: 26rpx 0;
  border-bottom: 1rpx solid #edf1ee;
}

.merchant-form-item:last-child {
  border-bottom: 0;
}

.merchant-form-label {
  display: block;
  color: #17231f;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.merchant-form-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 82rpx;
  margin-top: 14rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  background: #f6f8f7;
  color: #17231f;
  font-size: 28rpx;
  line-height: 82rpx;
}

.merchant-action-stack {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 26rpx;
}

.merchant-action-wide {
  width: 100%;
  min-width: 0;
}
