.page {
  padding: 32rpx;
  color: #1f2d2a;
  background: #f6f8f5;
  min-height: 100vh;
}
.warning {
  padding: 20rpx;
  margin-bottom: 24rpx;
  background: #fff4dc;
  color: #7a4a00;
  border-radius: 8rpx;
  line-height: 1.6;
}
.panel {
  padding: 28rpx;
  background: #ffffff;
  border-radius: 8rpx;
}
.title {
  font-weight: 700;
  font-size: 34rpx;
  margin-bottom: 20rpx;
}
text,
input {
  display: block;
  margin-bottom: 18rpx;
}
input {
  padding: 18rpx;
  background: #f6f8f5;
  border-radius: 8rpx;
}
button {
  margin-top: 16rpx;
}
.primary {
  background: #1f7a68;
  color: #ffffff;
}
