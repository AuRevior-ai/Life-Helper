<view class="page">
  <view class="warning">当前为模拟资质认证流程，请勿上传真实身份证、营业执照、保单等敏感材料。</view>
  <view class="panel">
    <text class="title">资质认证</text>
    <text>当前状态：{{qualificationStatus}}</text>
    <text wx:if="{{qualification.reject_reason}}">驳回原因：{{qualification.reject_reason}}</text>
    <input placeholder="主体类型 individual/business" value="{{form.subjectType}}" data-field="subjectType" bindinput="onInput" />
    <input placeholder="模拟姓名或法人姓名" value="{{form.realNameMock}}" data-field="realNameMock" bindinput="onInput" />
    <input placeholder="手机号" value="{{form.phone}}" data-field="phone" bindinput="onInput" />
    <button bindtap="saveDraft">保存草稿</button>
    <button class="primary" bindtap="submit">提交审核</button>
  </view>
</view>
