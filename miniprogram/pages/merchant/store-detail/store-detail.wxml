<view class="page">
  <view class="header">
    <text class="title">{{merchant.store_name}}</text>
    <text class="intro">{{merchant.store_intro}}</text>
  </view>
  <view wx:for="{{services}}" wx:key="_id" class="service" bindtap="goOrder" data-id="{{item._id}}">
    <text>{{item.service_name}}</text>
    <text class="price">¥{{item.priceText}}</text>
  </view>
</view>
