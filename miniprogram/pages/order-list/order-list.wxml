<view class="order-page">
  <view class="order-header">
    <view class="order-title">{{ title }}</view>
  </view>

  <scroll-view class="order-status-tabs" scroll-x enable-flex>
    <view class="order-tab-list">
      <view
        wx:for="{{ statusOptions }}"
        wx:key="value"
        class="order-tab {{ selectedStatusIndex === index ? 'order-tab--active' : '' }}"
        data-index="{{ index }}"
        bindtap="onStatusTap"
      >
        <text>{{ item.label }}</text>
        <view wx:if="{{ selectedStatusIndex === index }}" class="order-tab__line"></view>
      </view>
    </view>
  </scroll-view>

  <loading-view wx:if="{{ loading && !orders.length }}" text="正在加载订单"></loading-view>

  <view wx:elif="{{ orders.length }}" class="order-list">
    <order-card
      wx:for="{{ orders }}"
      wx:key="_id"
      order="{{ item }}"
      variant="center"
      bind:select="goOrderDetail"
      bind:action="handleOrderAction"
    ></order-card>
  </view>

  <view wx:else class="order-empty">
    <empty-state
      title="暂无订单"
      description="去首页看看需要的服务吧"
    ></empty-state>
    <button class="order-empty__button" bindtap="goHome">去首页</button>
  </view>
</view>
