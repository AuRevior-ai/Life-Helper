/* action buttons */

/* empty/loading */
.order-empty {
  padding-top: 18rpx;
}

.order-empty__button {
  display: flex;
  width: 240rpx;
  height: 64rpx;
  margin: 0 auto;
  padding: 0 28rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #16a34a;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 64rpx;
}

.order-empty__button::after {
  border: 0;
}

/* tabbar compatibility */
.page-shell {
  padding-top: 96rpx;
}
