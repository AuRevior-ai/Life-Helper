/* page */
.order-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 96rpx 32rpx 170rpx;
  background: #f7f8fa;
  color: #111827;
  font-family:
    -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial,
    sans-serif;
}

/* header */
.order-header {
  margin-bottom: 28rpx;
}

.order-title {
  color: #111827;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.25;
}

/* tabs */
.order-status-tabs {
  width: 100%;
  margin-bottom: 22rpx;
  white-space: nowrap;
}

.order-tab-list {
  display: inline-flex;
  min-width: 100%;
  align-items: center;
  gap: 38rpx;
}

.order-tab {
  position: relative;
  display: inline-flex;
  height: 58rpx;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  color: #374151;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 36rpx;
}

.order-tab--active {
  color: #16a34a;
  font-weight: 800;
}

.order-tab__line {
  width: 32rpx;
  height: 5rpx;
  margin-top: 8rpx;
  border-radius: 999rpx;
  background: #16a34a;
}

/* order card */
.order-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

