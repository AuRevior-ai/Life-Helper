.profile-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.profile-avatar {
  display: flex;
  width: 108rpx;
  height: 108rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #1f7a68;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 700;
}

.profile-main {
  min-width: 0;
  flex: 1;
}

.profile-name {
  color: #1f2d2a;
  font-size: 34rpx;
  font-weight: 700;
}

.profile-meta,
.profile-phone {
  margin-top: 8rpx;
  color: #64716d;
  font-size: 25rpx;
}

.primary-button,
.ghost-button {
  height: 88rpx;
  margin: 28rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.primary-button {
  background: #1f7a68;
  color: #ffffff;
}

.ghost-button {
  border: 1rpx solid #bfd8d0;
  background: #ffffff;
  color: #1f7a68;
}

.role-card {
  margin-bottom: 24rpx;
  border-color: #dfe8e3;
}

.role-card.worker {
  border-color: #d9c9aa;
  background: #fffaf0;
}

.role-card.admin {
  border-color: #b9d5dd;
  background: #f0f8fa;
}

.role-card__label {
  display: inline-flex;
  height: 42rpx;
  padding: 0 14rpx;
  align-items: center;
  border-radius: 8rpx;
  background: #e8f2ee;
  color: #1f7a68;
  font-size: 22rpx;
  font-weight: 700;
}

.role-card.worker .role-card__label {
  background: #f4ead5;
  color: #8b651f;
}

.role-card.admin .role-card__label {
  background: #dff0f4;
  color: #246276;
}

.role-card__title {
  margin-top: 18rpx;
  color: #183832;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.25;
}

.role-card__desc {
  margin-top: 10rpx;
  color: #64716d;
  font-size: 25rpx;
  line-height: 1.55;
}

.role-card__actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.role-card__actions .text-button {
  flex: 1;
}

.text-button.filled {
  border-color: #1f7a68;
  background: #1f7a68;
  color: #ffffff;
}

.menu-panel {
  padding: 0;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid #edf2ef;
  color: #1f2d2a;
  font-size: 29rpx;
}

.menu-item:last-child {
  border-bottom: 0;
}

.menu-item__hint {
  color: #72807b;
  font-size: 24rpx;
}
