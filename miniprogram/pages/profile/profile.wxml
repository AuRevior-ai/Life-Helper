<view class="page-shell">
  <view class="page-header">
    <view class="page-title">{{ title }}</view>
    <view class="page-subtitle">登录后管理账号资料，并选择本次进入的身份端</view>
  </view>

  <view class="profile-card panel">
    <view class="profile-avatar">{{ avatarText }}</view>
    <view class="profile-main">
      <view class="profile-name">{{ displayName }}</view>
      <view class="profile-meta">{{ roleText }} · {{ statusText }}</view>
      <view class="profile-phone">{{ displayPhone }}</view>
    </view>
  </view>

  <button wx:if="{{ !isLoggedIn }}" class="primary-button" bindtap="handleLogin">微信授权登录</button>
  <button wx:else class="ghost-button" bindtap="handleLogout">退出登录</button>

  <view class="menu-panel panel">
    <view wx:if="{{ isLoggedIn }}" class="menu-title">账号资料</view>
    <view wx:if="{{ isLoggedIn }}" class="menu-item emphasized" bindtap="goRoleSelect">
      <text>选择登录身份</text>
      <text class="menu-item__hint">五端入口</text>
    </view>
    <view class="menu-item" bindtap="goProfileEdit">
      <text>完善资料</text>
      <text class="menu-item__hint">昵称和手机号</text>
    </view>
    <view class="menu-item" bindtap="goOrderList">
      <text>我的订单</text>
      <text class="menu-item__hint">查看服务进度</text>
    </view>
    <view class="menu-item" bindtap="goAddressList">
      <text>地址管理</text>
      <text class="menu-item__hint">维护服务地址</text>
    </view>
  </view>
</view>
