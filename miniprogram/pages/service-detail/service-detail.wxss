@import "../../styles/ui-kit.wxss";

.detail-cover {
  position: relative;
  height: 300rpx;
  overflow: hidden;
  border-radius: 28rpx;
}

.detail-cover__tag {
  position: absolute;
  left: 24rpx;
  bottom: 24rpx;
}

.detail-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin: 28rpx 0;
}

.detail-title {
  font-size: 40rpx;
}

.detail-price {
  flex: 0 0 auto;
  font-size: 38rpx;
}

.detail-meta {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.meta-label,
.meta-value {
  display: block;
}

.meta-label {
  color: #6b7280;
  font-size: 24rpx;
}

.meta-value {
  margin-top: 8rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
}

.section-title {
  margin: 36rpx 0 18rpx;
}

.flow-panel {
  padding: 8rpx 28rpx;
}

.flow-item {
  display: flex;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf0f2;
}

.flow-item:last-child {
  border-bottom: 0;
}

.flow-index {
  display: flex;
  width: 42rpx;
  height: 42rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #eaf8e8;
  color: #16a34a;
  font-size: 22rpx;
  font-weight: 800;
}

.flow-text {
  flex: 1;
  color: #374151;
  font-size: 27rpx;
  line-height: 1.5;
}

.detail-submit {
  width: 100%;
  height: 88rpx;
  margin-top: 34rpx;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 88rpx;
}
