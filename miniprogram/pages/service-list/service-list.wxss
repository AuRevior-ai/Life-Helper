.category-tabs {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.category-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 148rpx;
  height: 64rpx;
  margin-right: 14rpx;
  padding: 0 24rpx;
  border: 1rpx solid #dfe8e3;
  border-radius: 10rpx;
  background: #ffffff;
  color: #52635e;
  font-size: 25rpx;
  font-weight: 600;
}

.category-tab--active {
  border-color: #1f7a68;
  background: #1f7a68;
  color: #ffffff;
}

.service-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
