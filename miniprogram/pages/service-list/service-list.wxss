@import "../../styles/ui-kit.wxss";

.category-tabs {
  width: 100%;
  margin-bottom: 24rpx;
  white-space: nowrap;
}

.category-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 148rpx;
  height: 58rpx;
  margin-right: 14rpx;
  padding: 0 26rpx;
  border: 1rpx solid #d1d5db;
  border-radius: 999rpx;
  background: #ffffff;
  color: #374151;
  font-size: 25rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.category-tab--active {
  border-color: #16a34a;
  background: #16a34a;
  color: #ffffff;
  font-weight: 800;
}

.service-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}
