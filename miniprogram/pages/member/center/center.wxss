@import "../../../styles/ui-kit.wxss";

.member-card,
.plan-card {
  margin-bottom: 22rpx;
}

.member-card {
  padding: 30rpx 28rpx;
}

.plan-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.card-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 800;
}

.card-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.mini-button {
  width: 180rpx;
  height: 68rpx;
  margin: 0;
  font-size: 24rpx;
  line-height: 68rpx;
}
