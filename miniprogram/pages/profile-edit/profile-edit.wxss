@import "../../styles/ui-kit.wxss";

.profile-edit-page {
  overflow-x: hidden;
  padding-top: calc(116rpx + env(safe-area-inset-top));
  padding-bottom: calc(172rpx + env(safe-area-inset-bottom));
}

.form-panel {
  margin-top: 0;
}

.form-input {
  border-radius: 18rpx;
  background: #f7f8fa;
  color: #111827;
}

.form-label {
  color: #374151;
}

.save-button {
  width: 100%;
  height: 88rpx;
  margin-top: 34rpx;
  font-size: 31rpx;
  line-height: 88rpx;
}
