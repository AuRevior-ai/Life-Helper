@import "../../styles/ui-kit.wxss";

.result-panel {
  text-align: center;
}

.result-mark {
  width: 104rpx;
  height: 104rpx;
  margin: 8rpx auto 24rpx;
  border-radius: 52rpx;
  background: #eaf8e8;
  color: #16a34a;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 104rpx;
}

.result-panel.failed .result-mark {
  background: #fff3e8;
  color: #ff6a00;
}

.result-panel.processing .result-mark {
  color: #6b7280;
}

.result-title {
  color: #111827;
  font-size: 36rpx;
  font-weight: 800;
}

.result-desc {
  margin-top: 16rpx;
  color: #6b7280;
  font-size: 26rpx;
  line-height: 1.6;
}

.result-meta {
  margin-top: 30rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #edf0f2;
}

.result-meta view {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  color: #374151;
  font-size: 26rpx;
}

.result-meta text:first-child {
  color: #6b7280;
}

.result-button {
  width: 100%;
  height: 76rpx;
  margin-top: 22rpx;
  font-size: 28rpx;
  line-height: 76rpx;
}
