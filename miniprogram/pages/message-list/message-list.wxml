<view class="message-page ui-page ui-page--dense">
  <view class="ui-header message-header">
    <view>
      <view class="ui-title">{{ title }}</view>
      <view class="ui-subtitle">未读 {{ unreadCount }} 条</view>
    </view>
    <button class="ui-secondary-button" bindtap="markAllRead">全部已读</button>
  </view>

  <loading-view
    wx:if="{{ loading && !messages.length }}"
    text="正在加载消息"
  ></loading-view>

  <view wx:elif="{{ messages.length }}" class="message-list">
    <view
      wx:for="{{ messages }}"
      wx:key="_id"
      class="message-item ui-card ui-card--compact {{ item.is_read ? '' : 'message-item--unread' }}"
      data-id="{{ item._id }}"
      data-index="{{ index }}"
      bindtap="handleMessageTap"
    >
      <view class="message-top">
        <text class="message-title">{{ item.title }}</text>
        <text class="message-state ui-pill {{ item.is_read ? 'ui-pill--gray' : 'ui-pill--green' }}">{{ item.readText }}</text>
      </view>
      <view class="message-type">{{ item.typeText }}</view>
      <view class="message-content">{{ item.content }}</view>
    </view>
  </view>

  <empty-state
    wx:else
    title="暂无消息"
    description="订单和审核进度会在这里提醒"
  ></empty-state>
</view>
