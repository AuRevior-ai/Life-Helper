@import "../../styles/ui-kit.wxss";

.message-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.message-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  margin-top: 18rpx;
}

.message-item--unread {
  outline: 2rpx solid #16a34a;
  box-shadow: 0 8rpx 28rpx rgba(22, 163, 74, 0.1);
}

.message-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.message-title {
  min-width: 0;
  color: #111827;
  font-size: 30rpx;
  font-weight: 800;
}

.message-type {
  color: #16a34a;
  font-size: 23rpx;
  font-weight: 700;
}

.message-type {
  margin-top: 10rpx;
}

.message-content {
  margin-top: 12rpx;
  color: #6b7280;
  font-size: 25rpx;
  line-height: 1.5;
}
