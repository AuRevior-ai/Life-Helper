.message-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 18rpx;
}

.message-item {
  border-color: #dfe8e3;
}

.message-item--unread {
  border-color: #1f7a68;
  box-shadow: 0 8rpx 22rpx rgba(31, 122, 104, 0.1);
}

.message-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.message-title {
  color: #1f2d2a;
  font-size: 30rpx;
  font-weight: 800;
}

.message-state,
.message-type {
  color: #1f7a68;
  font-size: 23rpx;
  font-weight: 700;
}

.message-type {
  margin-top: 10rpx;
}

.message-content {
  margin-top: 12rpx;
  color: #64716d;
  font-size: 25rpx;
  line-height: 1.5;
}
