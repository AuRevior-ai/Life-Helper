<view class="page-shell">
  <view class="page-header">
    <view class="page-title">{{ title }}</view>
    <view class="page-subtitle">请填写真实联系人信息，师傅会按此地址上门</view>
  </view>

  <loading-view wx:if="{{ loading }}" text="正在加载地址"></loading-view>

  <view wx:else class="form-panel panel">
    <view class="form-item">
      <text class="form-label">联系人</text>
      <input
        class="form-input"
        value="{{ form.contact_name }}"
        data-field="contact_name"
        placeholder="请输入联系人"
        bindinput="handleInput"
      />
    </view>

    <view class="form-item">
      <text class="form-label">手机号</text>
      <input
        class="form-input"
        value="{{ form.phone }}"
        data-field="phone"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        bindinput="handleInput"
      />
    </view>

    <view class="form-item">
      <text class="form-label">城市</text>
      <input
        class="form-input"
        value="{{ form.city }}"
        data-field="city"
        placeholder="例如：杭州"
        bindinput="handleInput"
      />
    </view>

    <view class="form-item">
      <text class="form-label">小区</text>
      <input
        class="form-input"
        value="{{ form.community }}"
        data-field="community"
        placeholder="请输入小区名称"
        bindinput="handleInput"
      />
    </view>

    <view class="form-item">
      <text class="form-label">详细地址</text>
      <textarea
        class="form-textarea"
        value="{{ form.detail_address }}"
        data-field="detail_address"
        placeholder="楼栋、门牌号等"
        bindinput="handleInput"
      ></textarea>
    </view>

    <view class="switch-row">
      <view>
        <view class="switch-title">默认地址</view>
        <view class="switch-hint">下单时优先使用</view>
      </view>
      <switch checked="{{ form.is_default }}" bindchange="handleDefaultChange" color="#1f7a68" />
    </view>
  </view>

  <button
    class="primary-button"
    loading="{{ saving }}"
    disabled="{{ saving }}"
    bindtap="handleSave"
  >保存地址</button>
</view>
