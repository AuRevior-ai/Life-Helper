@import "../../styles/ui-kit.wxss";

.form-panel {
  margin-top: 0;
}

.form-input,
.form-textarea {
  border-radius: 18rpx;
  background: #f7f8fa;
  color: #111827;
}

.form-label {
  color: #374151;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding-top: 24rpx;
}

.switch-title {
  color: #111827;
  font-size: 28rpx;
  font-weight: 800;
}

.switch-hint {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.save-button {
  width: 100%;
  height: 88rpx;
  margin-top: 34rpx;
  font-size: 31rpx;
  line-height: 88rpx;
}
