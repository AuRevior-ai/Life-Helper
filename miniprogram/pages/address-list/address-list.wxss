@import "../../styles/ui-kit.wxss";

.address-add-button {
  width: 100%;
  height: 76rpx;
  margin-bottom: 26rpx;
  font-size: 28rpx;
  line-height: 76rpx;
}

.address-card {
  margin-top: 22rpx;
}

.address-card__top,
.address-card__actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.address-card__name {
  color: #111827;
  font-size: 30rpx;
  font-weight: 800;
}

.address-card__phone {
  margin-left: 18rpx;
  color: #6b7280;
  font-size: 25rpx;
}

.address-card__address {
  margin-top: 16rpx;
  color: #374151;
  font-size: 27rpx;
  line-height: 1.5;
}

.address-card__actions {
  justify-content: flex-end;
  margin-top: 24rpx;
}

.address-danger-button {
  color: #a33a31;
}
