@import "../../styles/ui-kit.wxss";

.detail-card__top,
.status-grid,
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
}

.order-name {
  color: #111827;
  font-size: 34rpx;
  font-weight: 800;
}

.order-no {
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.order-price {
  flex: 0 0 auto;
  font-size: 38rpx;
}

.status-grid {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #edf0f2;
}

.meta-label,
.meta-value {
  display: block;
}

.meta-label {
  display: block;
  margin-bottom: 10rpx;
  color: #72807b;
  font-size: 24rpx;
}

.meta-value {
  margin-top: 8rpx;
  color: #1f7a68;
  font-size: 30rpx;
  font-weight: 800;
}

.info-panel {
  margin-top: 22rpx;
}

.info-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf0f2;
  color: #374151;
  font-size: 26rpx;
}

.info-row:first-child {
  padding-top: 0;
}

.info-row:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}

.info-row text:first-child {
  flex: 0 0 150rpx;
  color: #72807b;
}

.info-row text:last-child {
  flex: 1;
  text-align: right;
}

.info-row--address {
  align-items: flex-start;
}

.info-row--address text:last-child {
  line-height: 1.5;
}

.finish-images {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding-top: 18rpx;
}

.finish-image {
  width: 156rpx;
  height: 156rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #eef2f3 0%, #dfe8e3 100%);
}

.action-button {
  width: 100%;
  height: 76rpx;
  margin-top: 22rpx;
  font-size: 28rpx;
  line-height: 76rpx;
}
