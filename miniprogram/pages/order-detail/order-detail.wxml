<view class="page-shell">
  <view class="page-header">
    <view class="page-title">{{ title }}</view>
    <view class="page-subtitle">订单状态和服务信息以创建订单时的快照为准</view>
  </view>

  <loading-view wx:if="{{ loading }}" text="正在加载订单"></loading-view>

  <block wx:elif="{{ order }}">
    <view class="detail-card panel">
      <view class="detail-card__top">
        <view>
          <view class="order-name">{{ order.service_name }}</view>
          <view class="order-no">订单号：{{ order.order_no }}</view>
        </view>
        <view class="order-price">{{ priceText }}</view>
      </view>

      <view class="status-grid">
        <view>
          <text class="meta-label">订单状态</text>
          <text class="meta-value">{{ statusText }}</text>
        </view>
        <view>
          <text class="meta-label">支付状态</text>
          <text class="meta-value">{{ payStatusText }}</text>
        </view>
        <view>
          <text class="meta-label">售后状态</text>
          <text class="meta-value">{{ afterSaleStatusText }}</text>
        </view>
        <view>
          <text class="meta-label">退款状态</text>
          <text class="meta-value">{{ refundStatusText }}</text>
        </view>
      </view>
    </view>

    <view class="info-panel panel">
      <view class="info-row">
        <text>服务分类</text>
        <text>{{ order.category_name }}</text>
      </view>
      <view class="info-row">
        <text>预约时间</text>
        <text>{{ order.appointment_time }}</text>
      </view>
      <view class="info-row">
        <text>联系人</text>
        <text>{{ order.contact_name }} {{ order.contact_phone }}</text>
      </view>
      <view class="info-row info-row--address">
        <text>服务地址</text>
        <text>{{ order.full_address }}</text>
      </view>
      <view wx:if="{{ order.remark }}" class="info-row info-row--address">
        <text>备注</text>
        <text>{{ order.remark }}</text>
      </view>
      <view class="info-row">
        <text>服务原价</text>
        <text>{{ originalAmountText }}</text>
      </view>
      <view class="info-row">
        <text>会员优惠</text>
        <text>{{ memberDiscountText }}</text>
      </view>
      <view class="info-row">
        <text>优惠券优惠</text>
        <text>{{ couponDiscountText }}</text>
      </view>
      <view class="info-row">
        <text>实付金额</text>
        <text>{{ payableAmountText }}</text>
      </view>
      <view wx:if="{{ order.coupon_snapshot && order.coupon_snapshot.coupon_name }}" class="info-row">
        <text>使用优惠券</text>
        <text>{{ order.coupon_snapshot.coupon_name }}</text>
      </view>
      <view wx:if="{{ order.worker_id }}" class="info-row">
        <text>服务师傅</text>
        <button class="text-button" bindtap="goWorkerDetail">查看详情</button>
      </view>
      <view wx:if="{{ order.finish_remark }}" class="info-row info-row--address">
        <text>完工说明</text>
        <text>{{ order.finish_remark }}</text>
      </view>
      <view wx:if="{{ order.finish_images && order.finish_images.length }}" class="finish-images">
        <image wx:for="{{ order.finish_images }}" wx:key="*this" class="finish-image" src="{{ item }}" mode="aspectFill"></image>
      </view>
    </view>

    <button
      wx:if="{{ canPay }}"
      class="primary-button"
      loading="{{ submitting }}"
      disabled="{{ submitting }}"
      bindtap="handlePay"
    >模拟支付</button>

    <button
      wx:if="{{ canCancel }}"
      class="ghost-button"
      loading="{{ submitting }}"
      disabled="{{ submitting }}"
      bindtap="handleCancelOrder"
    >取消订单</button>

    <button
      wx:if="{{ canReview }}"
      class="primary-button"
      bindtap="goReview"
    >去评价</button>

    <button
      wx:if="{{ canTip }}"
      class="primary-button"
      bindtap="goTip"
    >打赏师傅</button>

    <button
      wx:if="{{ canApplyAfterSale }}"
      class="ghost-button"
      bindtap="goAfterSaleApply"
    >申请售后 / 申请退款</button>

    <button
      wx:if="{{ canViewAfterSale }}"
      class="ghost-button"
      bindtap="goAfterSaleDetail"
    >查看售后</button>
  </block>

  <empty-state
    wx:else
    title="订单不存在"
    description="请返回订单列表重新查看"
  ></empty-state>
</view>
