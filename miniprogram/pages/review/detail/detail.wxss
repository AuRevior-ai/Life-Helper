@import "../../../styles/ui-kit.wxss";

.review-card {
  overflow: hidden;
  padding: 0;
}

.review-card__header {
  display: flex;
  padding: 30rpx;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  border-bottom: 1rpx solid #edf0f2;
}

.review-card__title {
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.3;
}

.review-card__meta {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.4;
}

.rating-badge {
  display: flex;
  min-width: 112rpx;
  height: 112rpx;
  padding-top: 20rpx;
  align-items: baseline;
  justify-content: center;
  border-radius: 56rpx;
  box-sizing: border-box;
  background: #fff3e8;
  color: #ff6a00;
}

.rating-badge__score {
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1;
}

.rating-badge__unit {
  margin-left: 4rpx;
  font-size: 22rpx;
}

.content-section {
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #edf0f2;
}

.content-section--last {
  border-bottom: 0;
}

.section-label {
  margin-bottom: 12rpx;
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 600;
}

.section-body {
  color: #111827;
  font-size: 28rpx;
  line-height: 1.65;
  word-break: break-all;
}

.section-body--empty {
  color: #9ca3af;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.review-tag {
  display: inline-flex;
  min-height: 40rpx;
  padding: 0 16rpx;
  align-items: center;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: #4b5563;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.review-action {
  width: calc(100% - 60rpx);
  height: 78rpx;
  margin: 24rpx 30rpx 30rpx;
  font-size: 28rpx;
  line-height: 78rpx;
}
