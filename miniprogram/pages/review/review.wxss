@import "../../styles/ui-kit.wxss";

.review-panel {
  margin-top: 0;
}

.rating-row {
  display: flex;
  gap: 14rpx;
  margin: 16rpx 0 22rpx;
}

.rating-item {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #d1d5db;
  border-radius: 999rpx;
  background: #ffffff;
  color: #6b7280;
  font-size: 30rpx;
  font-weight: 800;
}

.rating-item--active {
  border-color: #16a34a;
  background: #16a34a;
  color: #ffffff;
}

.form-textarea {
  border-radius: 18rpx;
  background: #f7f8fa;
}

.submit-button {
  width: 100%;
  height: 88rpx;
  margin-top: 34rpx;
  font-size: 31rpx;
  line-height: 88rpx;
}
