<view class="custom-tabbar">
  <view
    wx:for="{{ list }}"
    wx:key="pagePath"
    class="custom-tabbar__item {{ selected === index ? 'custom-tabbar__item--active' : '' }}"
    data-index="{{ index }}"
    bindtap="switchTab"
  >
    <view class="tab-icon tab-icon--{{ item.icon }}"></view>
    <text>{{ item.text }}</text>
  </view>
</view>
